{# Repair Services - 1920px (Figma 34799:68554). Each service card has id="<catalog.repairServices slug>"
   so the header menu links /repair-services/#<slug> land on it. #}
{% import "macros/ui.njk" as ui with context %}
{% import "content/macros.njk" as c with context %}
{% set r = contentPages.repair %}

{{ ui.breadcrumbs([{ label: "Repair Services" }]) }}

{# Hero: instruments photo on the right, navy fade from the left over white.
   Phones (mobile 34897:7756): 40/32 padding, 20px gap, 16/24 intro. #}
{{ c.hero({
  title: "Repair Services", text: r.intro, figma: "34799:68558", image: "91e2c639", bg: "bg-white",
  photo: "inset-0 h-full w-full object-cover md:inset-auto md:right-0 md:top-[3px] md:h-[484px] md:w-[67.14%] md:[mask-image:linear-gradient(90deg,transparent,#000_10%)]"
}) }}

{# The six repair services. Phones (mobile 34897:7756): Medium 28/36 title, 16px under it, cards 8px apart. #}
<section class="bg-white" data-figma="34799:68567">
  <div class="container-page flex flex-col gap-4 py-10 md:gap-8">
    <h2 class="text-mobile-h1 font-medium text-heading md:text-h2 md:font-bold lg:text-h1">Expert Surgical Instrument Repair Services</h2>
    <ul class="grid gap-2 sm:grid-cols-2 md:gap-x-6 md:gap-y-8 lg:grid-cols-3" data-figma="34799:68570">
      {% for s in r.services %}
      <li class="flex min-w-0 [&>*]:flex-1">{{ c.imageCard({ title: s.title, image: s.image, id: s.slug, figma: s.figma, imgClass: s.imgClass }, "large") }}</li>
      {% endfor %}
    </ul>
  </div>
</section>

{{ c.trustBand("34799:68578", "py-10") }}

{# Why Choose Ambler for Instrument Repair? Phones (mobile 34897:7756): Bold 28/36 title, 24px under it, cards 16px apart. #}
<section class="bg-white" data-figma="34799:68583">
  <div class="container-page flex flex-col gap-6 py-10 md:gap-8">
    <h2 class="text-mobile-h1 font-bold text-heading md:text-h2">Why Choose Ambler for Instrument Repair?</h2>
    <div class="grid gap-4 md:grid-cols-2 md:gap-6 md:[&>*]:min-h-[176px]" data-figma="34799:68588">
      {% for w in r.whyChoose %}
      {% if w.link %}
      {% call c.descriptionCard(w.title, w.text, "", w.figma) %} <a href="{{ w.href }}" class="link">{{ w.link }}</a>.{% endcall %}
      {% else %}
      {{ c.descriptionCard(w.title, w.text, "", w.figma) }}
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{# Surgical Instrument Repair for Every Need: technician photo band, text on the right.
   Phones (mobile 34897:7756): a 132px photo strip above the navy text block, Medium 24/32 title (orange line 4px lower),
   16/24 text 16px apart. #}
<section class="relative isolate overflow-hidden bg-primary-500" data-figma="34799:68611">
  <img src="{{ 'de7cda38' | img }}" alt="" loading="lazy" class="relative -z-10 block h-[132px] w-full object-cover object-left md:absolute md:inset-0 md:h-full">
  <div aria-hidden="true" class="absolute inset-0 -z-10 hidden bg-primary-500/80 md:block lg:hidden"></div>
  <div class="container-page flex py-10 lg:min-h-[424px] lg:items-center">
    <div class="flex max-w-[886px] flex-col gap-6 md:gap-7 lg:ml-auto" data-figma="34799:68612">
      <h2 class="text-h3 font-medium text-white md:text-h2 md:font-bold">Surgical Instrument Repair for Every Need<br><span class="mt-1 inline-block text-accent md:mt-0 md:inline">Restore Precision. Extend Instrument Life.</span></h2>
      <div class="flex flex-col gap-4 text-base text-white md:gap-3 md:text-lg">
        {% for p in r.everyNeed %}<p>{{ p }}</p>{% endfor %}
      </div>
    </div>
  </div>
</section>

{# Frequently Asked Questions + contact card. #}
{{ c.faqSection(r.faq, { section: "34799:68629", list: "34799:68632", card: "34799:68654" }) }}
