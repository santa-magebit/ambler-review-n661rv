---
layout: layouts/base.njk
title: Product Lines
permalink: /product-lines/
---
{#- Figma "PLP - Product Lines - 1920px" (34907:8363). -#}
{% import "macros/ui.njk" as ui with context %}
{% import "plp/macros.njk" as plp_ui with context %}
{% set pl = plp.productLinePage %}

{{ ui.breadcrumbs([{ label: "Product Lines" }]) }}
{{ plp_ui.hero({ eyebrow: pl.eyebrow, title: pl.title, text: pl.heroText, image: "2578dcdb", wide: true }, "34910:123668") }}

{# Popular Product Lines #}
<section class="bg-white" data-figma="34907:8376">
  <div class="container-page py-10">
    {{ plp_ui.titleRow("Popular Product Lines") }}
    <div class="mt-8">{{ plp_ui.cardGrid(pl.popular, "34907:8386") }}</div>
  </div>
</section>

{# All Product Lines: search and sort over the tiles #}
<section class="bg-secondary-100" data-figma="34907:8416" x-data="plpLines">
  <div class="container-page py-10">
    <div class="flex flex-wrap items-center justify-between gap-x-10 gap-y-4" data-figma="34912:8508">
      <h2 class="flex flex-wrap items-baseline gap-2 text-h2 font-bold text-heading md:text-h1">All Product Lines <span class="text-lg font-normal text-body" x-text="countLabel">{{ pl.all.length }} product lines</span></h2>
      <div class="flex w-full flex-wrap items-center gap-x-10 gap-y-4 md:w-auto">
        <label class="relative block w-full md:w-[320px]">
          <span class="sr-only">Search product lines</span>
          <span class="pointer-events-none absolute left-5 top-1/2 -translate-y-1/2 text-primary-500">{% icon "search" %}</span>
          <input type="search" x-model="q" placeholder="Search product lines" class="input pl-[60px] font-medium placeholder:font-medium">
        </label>
        <div class="flex items-center gap-5" x-data="{ open: false }" @click.outside="open = false" @keydown.escape="open = false">
          <span class="shrink-0 text-base text-body" id="lines-sort">Sort By:</span>
          <div class="relative w-[240px]">
            <button type="button" @click="open = !open" :aria-expanded="open" aria-haspopup="true" aria-labelledby="lines-sort lines-sort-v" class="flex h-[52px] w-full items-center justify-between gap-3 rounded border bg-white px-5 text-left text-lg font-medium" :class="open ? 'border-primary-500 text-ink' : 'border-secondary-200 text-body hover:border-grayscale-400'">
              <span id="lines-sort-v" x-text="sortLabel">Featured</span>
              <span x-show="!open">{% icon "dropdown" %}</span><span x-show="open" x-cloak>{% icon "dropdown-up" %}</span>
            </button>
            <ul x-show="open" x-cloak x-transition.opacity class="absolute right-0 top-full z-30 mt-1 w-full rounded border border-outline bg-white py-2 shadow-[0_8px_24px_0_rgba(13,48,84,0.12)]">
              <template x-for="o in sorts" :key="o.value">
                <li><button type="button" @click="sort = o.value; open = false" class="block w-full px-5 py-2.5 text-left text-base text-body hover:bg-secondary-100 hover:font-medium hover:text-[#0d3155]" :class="sort === o.value && 'font-medium text-[#0d3155]'" x-text="o.label"></button></li>
              </template>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <ul class="mt-10 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-6" data-figma="34911:8953">
      {% for b in pl.all %}
      <li class="min-w-0" x-show="isShown('{{ b.slug }}')" :style="{ order: rank('{{ b.slug }}') }" data-slug="{{ b.slug }}" data-name="{{ b.name }}">{{ plp_ui.logoTile(b) }}</li>
      {% endfor %}
    </ul>
    <p x-show="!count" x-cloak class="mt-8 rounded border border-secondary-200 bg-white px-6 py-12 text-center text-lg text-heading">We couldn&rsquo;t find anything for your search</p>
  </div>
</section>
