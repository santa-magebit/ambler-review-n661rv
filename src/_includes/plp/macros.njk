{#
  "Types of …" cards (34719:11450): 3-up cards with a title strip + arrow and a description.
  cards: [{ title, text, href? , filter? }]; without href the card applies a listing filter or is a prototype gap.
  Phones (34726:18657): one column, gap 8; intro 16/24.
#}
{% macro typesOf(t) %}
<section class="bg-white" data-figma="{{ t.figma }}">
  <div class="container-page py-8 md:py-10">
    <div class="flex max-w-[756px] flex-col gap-4 md:gap-3">
      <h2 class="text-h3 font-medium text-heading md:text-h2 md:font-bold">{{ t.title }}</h2>
      <p class="text-base text-body md:text-lg">{{ t.intro }}</p>
    </div>
    <ul class="mt-4 grid gap-2 md:mt-8 md:grid-cols-2 md:gap-6 xl:grid-cols-3">
      {% for c in t.cards %}
      <li class="min-w-0">
        <a href="{{ c.href or '#products' }}" {% if c.filter %}@click.prevent="$dispatch('plp-filter', '{{ c.filter }}')"{% elif not c.href %}data-proto{% endif %}
           class="card-hover group flex h-full flex-col gap-4 rounded border border-body bg-white pb-5">
          <span class="flex h-14 items-center gap-3 rounded-t bg-secondary-100 px-5 group-hover:bg-primary-500">
            <span class="text-h3 font-medium tracking-title text-primary-500 group-hover:text-white">{{ c.title }}</span>
            {% icon "arrow-narrow-right", "h-6 w-6 text-primary-500 group-hover:text-white" %}
          </span>
          <span class="px-5 text-lg text-body">{{ c.text }}</span>
        </a>
      </li>
      {% endfor %}
    </ul>
    {% if t.outro %}<p class="mt-4 max-w-[756px] text-base text-body md:mt-8 md:text-lg">{{ rich(t.outro) }}</p>{% endif %}
  </div>
</section>
{% endmacro %}

{#
  "Shop by Product Lines" (34777:59035): title + "Shop All Product Lines", 2 rows of 6 logo tiles (239x80).
  bg: "white" (specialty) or "tint" (#eff7fd, category page 34719:11345; white on phones like 34726:18657).
  Phones: 2 columns of 61px tiles, gap 8, the button full width under them.
#}
{% macro brandsStrip(bg="white", figma="34777:59035") %}
