      <span class="min-w-0">
        <span class="block text-lg font-medium text-primary-500 md:text-ink">{{ t.title }}</span>
        <span class="mt-1 block text-base text-card md:mt-0 md:text-body">{{ t.text }}</span>
      </span>
    </li>
    {% endfor %}
  </ul>
</section>
