---
layout: account/layout.njk
title: Edit Account Information
permalink: /customer/account/edit/
figma: "14714:137321"
---
{% import "macros/ui.njk" as ui with context %}
{% import "account/macros.njk" as acc with context %}
{# Collapsed (14714:137357) and "Change Email" checked (14714:137321). Change Password is not drawn
   checked; it reveals the Magento password fields in the same style. ?changepass opens it. #}
<div class="flex flex-col gap-10" data-figma="14714:137343">
  {{ acc.pageTitle("Edit Account Information") }}
  <form x-data="accountEdit" @submit.prevent="submit" novalidate
        class="flex w-full max-w-[600px] flex-col gap-7 rounded bg-secondary-100 p-6 sm:p-10" data-figma="14714:137346">
    <h2 class="text-h3 font-medium text-heading">Account Information</h2>
    {{ ui.field("First Name", "firstname", "text", false, "given-name", "", account.accountForm.firstName) }}
    {{ ui.field("Last Name", "lastname", "text", false, "family-name", "", account.accountForm.lastName) }}
    {{ acc.checkbox("Change Email", 'x-model="changeEmail"', "change_email") }}
    <template x-if="changeEmail">
      {{ ui.field("Email", "email", "email", false, "email", "", account.accountForm.email) }}
    </template>
    {{ acc.checkbox("Change Password", 'x-model="changePassword"', "change_password") }}
    <template x-if="changeEmail">
      {{ acc.alert("To change e-mail address please enter your password!") }}
    </template>
    <template x-if="changeEmail || changePassword">
      {{ acc.passwordField("Current Password", "current-password", "Enter current password", true) }}
    </template>
    <template x-if="changePassword">
      {{ acc.passwordField("New Password", "new-password", "Enter your password", true, "new-password") }}
    </template>
    <template x-if="changePassword">
      {{ acc.passwordField("Confirm New Password", "new-password-confirm", "Re enter your password", true, "new-password") }}
    </template>
    <button type="submit" class="btn-primary w-full">Save Account Information</button>
  </form>
</div>
