{#
  Building blocks for the content pages (Home, About, Repair Services, Sterilization, Contact).
  Import with: {% import "content/macros.njk" as c with context %}
  Gradients and copy live in src/_data/contentPages.js (global `contentPages`).
#}

{# Hero title (Landing Page 34141:37899): Medium 56/64 white (phones 32/40, mobile 34141:38087), 8px gap, 2px gradient line under the text. #}
{% macro heroTitle(title) %}
<h1 class="inline-block bg-bottom bg-no-repeat pb-2.5 text-h2 font-medium text-white md:text-hero" style="background-image: {{ contentPages.gradients.titleLine }}; background-size: 100% 2px">{{ title }}</h1>
{% endmacro %}

{# Hero, one component for Home (34141:37899), About (34971:47249), Repair Services (34799:68558) and Free Lifetime
   Repair (35122:1294): a photo under a navy fade from the left, 593px column with the title, intro and optional caller
   content (buttons). A photo that starts partway across fades in over its first 10% (mask in `photo`) so no line shows
   where it meets the fade.
   Phones (mobile 34141:38087, 34974:121015, 34897:7756): the phone fade over the photo, 16/24 intro.
   h: { title, text, image (hash8), photo (placement classes), figma, fade? (web gradient, default heroFade),
        bg? (under the photo), pad? (phone padding), gap? (phone gap),
        eyebrow? (Medium 18/28 line 12px above the title, Free Lifetime Repair 35122:1299),
        footnote? { href, label } (a "*" after the intro linking to the fine print),
        scrim? (classes of a tint over the photo, for a light photo that runs under the text) } #}
{% macro hero(h) %}
<section class="relative isolate overflow-hidden {{ h.bg or 'bg-primary-500' }}" data-figma="{{ h.figma }}">
  <img src="{{ h.image | img }}" alt="" class="absolute -z-10 {{ h.photo }}">
  {% if h.scrim %}<div aria-hidden="true" class="absolute inset-0 -z-10 {{ h.scrim }}"></div>{% endif %}
  <div aria-hidden="true" class="absolute inset-0 -z-10 md:hidden" style="background-image: {{ contentPages.gradients.heroFadePhone }}"></div>
  <div aria-hidden="true" class="absolute inset-0 -z-10 hidden md:block" style="background-image: {{ h.fade or contentPages.gradients.heroFade }}"></div>
  <div class="container-page flex items-center {{ h.pad or 'pb-8 pt-10' }} md:min-h-[360px] md:py-12 lg:min-h-[480px]">
    <div class="flex max-w-[593px] flex-col items-start {{ h.gap or 'gap-5' }} md:gap-7">
      {% if h.eyebrow %}
      <div class="flex flex-col items-start gap-2 md:gap-3">
        <p class="text-base font-medium text-white md:text-lg">{{ h.eyebrow }}</p>
        {{ heroTitle(h.title) }}
      </div>
      {% else %}
      {{ heroTitle(h.title) }}
      {% endif %}
      <p class="text-base text-white md:text-lg">{{ h.text }}{% if h.footnote %}<a href="{{ h.footnote.href }}" aria-label="{{ h.footnote.label }}" class="-mx-1 px-1 text-white hover:text-secondary-200">*</a>{% endif %}</p>
      {% if caller %}{{ caller() }}{% endif %}
    </div>
  </div>
</section>
{% endmacro %}

{# Title band for pages Figma does not draw (Sterilization, Contact): the hero's navy, title and optional intro, without a photo.
   Phones follow the mobile Repair Services hero (34897:7756): 40/32 padding, 20px gap, 16/24 text. #}
{% macro titleBand(title, text) %}
<section class="bg-primary-500">
  <div class="container-page flex flex-col items-start gap-5 pb-8 pt-10 md:gap-7 md:py-12 lg:py-16">
    {{ heroTitle(title) }}
    {% if text %}<p class="max-w-[593px] text-base text-white md:text-lg">{{ text }}</p>{% endif %}
  </div>
</section>
{% endmacro %}

{# "why us?" band (34141:38022): #f1f5f8, four items with 52px round navy icons.
   Phones (USPs Container, mobile 34141:38087 and 34897:7756): #f5f8fa, one column 20px apart, 60px icons with
   32px glyphs, primary title 4px above #3a526d text. pad = phone top/bottom padding (Landing 28px, Repair 40px). #}
{% macro trustBand(figma, pad="py-7") %}
<section class="bg-menu md:bg-secondary-100" aria-label="Why Ambler Surgical" data-figma="{{ figma }}">
  <ul class="container-page grid gap-5 {{ pad }} sm:grid-cols-2 md:gap-6 md:py-10 xl:grid-cols-4">
    {% for t in contentPages.trust %}
    <li class="flex min-w-0 items-center gap-4">
      <span class="flex h-[60px] w-[60px] shrink-0 items-center justify-center rounded-full bg-primary-500 text-white md:h-[52px] md:w-[52px]">{% icon t.icon, "h-8 w-8 md:h-7 md:w-7" %}</span>
      <span class="flex min-w-0 flex-col gap-1 md:block">
        <span class="block text-lg font-medium text-primary-500 md:text-ink">{{ t.title }}</span>
        <span class="block text-base text-card md:text-body">{{ t.text }}</span>
      </span>
    </li>
    {% endfor %}
  </ul>
</section>
{% endmacro %}

{#
  Category card with a title strip and a photo (styleguide "Category card", 14714:57254).
  Hover turns the strip navy with white text (styleguide hover state).
  variant: "sub"    Landing Page Ophthalmology sub-cards (268x244, #dde7ee border, #f1f5f8 strip, 18px title;
                    phones 159x155, #e4e8eb border, 48px #f5f8fa strip, Bold 14/18 title, arrow at the end)
           "medium" Landing Page repair band (243x264, navy border, #f5f8fa strip, 18px title;
                    phones 171x200, 48px strip, Bold 16/24 title, arrow at the end)
           "large"  Repair Services grid (496x342, navy border, #f5f8fa strip, 24px title;
                    phones 350x200, 44px strip, Medium 20/28 title)
  card: { title, image, href?, id?, figma?, imgClass? }. Without href the card is data-proto.
  imgClass reproduces the Figma crop or flip of a photo (e.g. object-top, -scale-y-100).
  Phone sizes are 1px under Figma's inside the border (strip height, side padding, photo box), because a Figma
  stroke takes no space and the CSS border does; the cards then come out at Figma's outer size.
#}
{% macro imageCard(card, variant) %}
{% set variants = {
  sub: { box: "border-[#e4e8eb] md:border-outline", head: "h-[47px] justify-between gap-1 bg-menu px-[11px] text-sm font-bold leading-[18px] md:h-[52px] md:justify-start md:gap-2 md:bg-secondary-100 md:px-4 md:text-lg md:font-medium", media: "aspect-[157/106] md:aspect-[268/192]" },
  medium: { box: "border-primary-500", head: "h-[47px] justify-between gap-1 bg-menu px-[11px] text-base font-bold md:h-[52px] md:justify-start md:gap-3 md:px-5 md:text-lg md:font-medium", media: "aspect-[169/151] md:aspect-[243/212]" },
  large: { box: "border-primary-500", head: "h-[43px] gap-3 bg-menu px-[11px] text-h4 font-medium tracking-title sm:text-h3 md:h-14 md:px-5", media: "aspect-[348/155] md:aspect-[496/286]" }
} %}
{% set v = variants[variant] %}
<a href="{{ card.href or ('#' + card.id if card.id else '#') }}" {% if card.id %}id="{{ card.id }}"{% endif %} {% if not card.href %}data-proto{% endif %} {% if card.figma %}data-figma="{{ card.figma }}"{% endif %}
   class="card-hover group flex min-w-0 scroll-mt-6 flex-col overflow-hidden rounded border bg-white target:ring-2 target:ring-accent target:ring-offset-2 {{ v.box }}">
  <span class="flex shrink-0 items-center text-primary-500 transition-colors duration-300 ease-out group-hover:bg-primary-500 group-hover:text-white {{ v.head }}">
    <span class="truncate">{{ card.title }}</span>{% icon "arrow-narrow-right", "h-6 w-6" %}
  </span>
  <span class="relative block overflow-hidden bg-white {{ v.media }}">
    <img src="{{ card.image }}" alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover {{ card.imgClass }}">
  </span>
</a>
{% endmacro %}

{#
  Title strip of the description cards: 56px, #f1f5f8, Medium 24/32 -2% primary.
  variant "home" / "home-lead": Landing Page specialty cards on phones (mobile 34141:38087): 48px #f5f8fa strip,
  Bold 16/24, arrow at the end, 12px sides (16px on the Ophthalmology card). Phone paddings are 1px under Figma's
  because the CSS border takes the 1px that a Figma stroke does not, so titles get Figma's width.
#}
{% macro descriptionHead(title, arrow=false, variant="") %}
{% set phone = { home: "min-h-[47px] justify-between gap-1 bg-menu px-[11px] py-[11px] text-base font-bold", "home-lead": "min-h-[47px] justify-between gap-1 bg-menu px-[15px] py-[11px] text-base font-bold" }[variant] %}
<span class="flex shrink-0 items-center text-primary-500 transition-colors duration-300 ease-out group-hover:bg-primary-500 group-hover:text-white {{ (phone + ' md:min-h-14 md:justify-start md:gap-3 md:bg-secondary-100 md:px-5 md:py-3 md:text-h3 md:font-medium md:tracking-title') if phone else 'min-h-14 gap-3 bg-secondary-100 px-5 py-3 text-h3 font-medium tracking-title' }}">
  {{ title }}{% if arrow %}{% icon "arrow-narrow-right", "h-6 w-6" %}{% endif %}
</span>
{% endmacro %}

{#
  Card with a title strip and a short text (Landing Page specialty cards 34141:37949,
  Repair Services "Why Choose" cards 34799:68590): #4e6284 border, 16px gap, 20px sides and bottom.
  With href the whole card is a link and the strip gets an arrow.
  variant "home": Landing Page specialty cards on phones (mobile 34141:38087): #3a526d border, 12px gap,
  12px sides and bottom, 16/24 #3a526d text. cls: extra classes on the card.
#}
{% macro descriptionCard(title, text, href="", figma="", variant="", cls="") %}
{% set home = variant == "home" %}
{% if href %}
<a href="{{ href }}" {% if figma %}data-figma="{{ figma }}"{% endif %} class="card-hover group flex min-w-0 flex-col overflow-hidden rounded border bg-white {{ 'gap-3 border-card pb-[11px] md:gap-4 md:border-body md:pb-5' if home else 'gap-4 border-body pb-5' }} {{ cls }}">
  {{ descriptionHead(title, true, variant) }}
  <span class="block {{ 'px-[11px] text-base text-card md:px-5 md:text-lg md:text-body' if home else 'px-5 text-lg text-body' }}">{{ text }}</span>
</a>
{% else %}
<div {% if figma %}data-figma="{{ figma }}"{% endif %} class="flex min-w-0 flex-col gap-4 overflow-hidden rounded border border-body bg-white pb-5">
  {{ descriptionHead(title) }}
  <p class="px-5 text-lg text-body">{{ text }}{% if caller %}{{ caller() }}{% endif %}</p>
</div>
{% endif %}
{% endmacro %}

{# Bullet item (About 34974:1180): 8x2 orange dash centred on the first 28px line, 12px gap. The dash keeps a
   28px line box, so one-line items stay 28px tall with the 24px phone text (mobile 34974:121015). #}
{% macro bullet(class="") %}
<li class="flex gap-3 {{ class }}">
  <span aria-hidden="true" class="mb-[13px] mt-[13px] h-0.5 w-2 shrink-0 rounded-[1px] bg-accent"></span>
  <span class="min-w-0">{{ caller() }}</span>
</li>
{% endmacro %}

{# Orange outline quote mark (36px "Frame" in each testimonial card, 34974:1297). #}
{% macro quoteMark() %}
<svg viewBox="0 0 36 36" class="h-9 w-9 shrink-0 text-accent" fill="none" aria-hidden="true">
  <g stroke="currentColor" stroke-width="2" stroke-linejoin="round">
    <path d="M15 6.5C10 8 6 12.5 6 18v10.5A2.5 2.5 0 0 0 8.5 31h4a2.5 2.5 0 0 0 2.5-2.5V22a2.5 2.5 0 0 0-2.5-2.5H11c0-4 1.5-7 4-8.5z"/>
    <path d="M31 6.5C26 8 22 12.5 22 18v10.5a2.5 2.5 0 0 0 2.5 2.5h4a2.5 2.5 0 0 0 2.5-2.5V22a2.5 2.5 0 0 0-2.5-2.5H27c0-4 1.5-7 4-8.5z"/>
  </g>
</svg>
{% endmacro %}

{# Chevron down, 28px, 2px stroke (mobile About "Read more", icon/24px/chevron-down). #}
{% macro chevronDown() %}
<svg viewBox="0 0 28 28" class="h-7 w-7 shrink-0" fill="none" aria-hidden="true"><path d="M7 10.5l7 7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
{% endmacro %}

{# Frequently Asked Questions + contact card (Repair Services 34799:68629, Free Lifetime Repair 35122:1381).
   Phones (mobile 34897:7756): Medium 24/32 title 16px above the list; the navy card runs edge to edge under the
   section, 32px padding, full-width button.
   faq: [{ id, q, a: [paragraphs] | null (answer not written: data-proto), link?: { label, href } }]
   figma: { section, list, card } node ids. #}
{% macro faqSection(faq, figma) %}
<section class="bg-menu" data-figma="{{ figma.section }}">
  <div class="container-page flex flex-col gap-4 py-10 md:gap-8">
    <h2 class="text-h3 font-medium text-heading md:text-h2 md:font-bold">Frequently Asked Questions</h2>
    <div class="grid items-start gap-10 lg:grid-cols-[886fr_590fr] lg:gap-[60px]">
      <div x-data="faq" class="min-w-0" data-figma="{{ figma.list }}">
        {% for f in faq %}
        <div class="border-b border-secondary-200 py-4">
          {% if f.a %}
          <h3>
            <button type="button" @click="toggle('{{ f.id }}')" :aria-expanded="open === '{{ f.id }}'" aria-controls="faq-{{ f.id }}"
                    class="flex w-full items-center gap-3 text-left text-lg font-medium" :class="open === '{{ f.id }}' ? 'text-accent' : 'text-ink hover:text-primary-500'">
              <span class="flex-1">{{ f.q }}</span>
              <span x-show="open !== '{{ f.id }}'">{% icon "dropdown", "h-6 w-6" %}</span>
              <span x-show="open === '{{ f.id }}'" x-cloak>{% icon "dropdown-up", "h-6 w-6" %}</span>
            </button>
          </h3>
          <div id="faq-{{ f.id }}" x-show="open === '{{ f.id }}'" x-collapse x-cloak>
            <div class="flex flex-col gap-3 pt-3 text-lg text-body">
              {% for p in f.a %}<p>{{ p }}</p>{% endfor %}
              {% if f.link %}<p><a href="{{ f.link.href }}" class="link">{{ f.link.label }}</a></p>{% endif %}
            </div>
          </div>
          {% else %}
          {# Answer not written in Figma yet. #}
          <h3>
            <button type="button" data-proto aria-expanded="false" class="flex w-full items-center gap-3 text-left text-lg font-medium text-ink hover:text-primary-500">
              <span class="flex-1">{{ f.q }}</span>{% icon "dropdown", "h-6 w-6" %}
            </button>
          </h3>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      <div class="-mx-5 -mb-10 flex min-w-0 flex-col items-start gap-6 bg-primary-500 px-5 py-8 md:mx-0 md:mb-0 md:rounded md:p-7" data-figma="{{ figma.card }}">
        <div class="flex flex-col gap-4">
          <h2 class="text-h3 font-medium text-white md:text-h2 md:font-bold">Can't find your answer?</h2>
          <p class="text-base text-[#d3dce5] md:text-lg">Our instrument specialists respond within one business day.</p>
        </div>
        {{ arrowButton("Contact Our Team", "/contact/", "", "w-full md:w-auto") }}
      </div>
    </div>
  </div>
</section>
{% endmacro %}

{# Orange button with the arrow (Landing Page hero 34141:37899 "btn": 12/30/12/32 padding). cls: extra classes, e.g. full width on phones. #}
{% macro arrowButton(label, href, attrs="", cls="") %}
<a href="{{ href }}" class="btn-accent whitespace-nowrap pr-[30px] {{ cls }}" {{ attrs | safe }}>{{ label }}{% icon "arrow-narrow-right" %}</a>
{% endmacro %}
