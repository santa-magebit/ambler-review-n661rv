{#
  Guest only. Express checkout buttons from "Checkout - Guest - Express Checkout & Gift Card"
  (34799:90408): PayPal and Google Pay, then an "Or" divider. Not part of the prototype (data-proto).
#}
{% import "checkout/macros.njk" as co with context %}

<div x-show="!$store.auth.loggedIn" class="flex flex-col gap-7" data-figma="34799:90408">
  <div class="grid grid-cols-2 gap-3">
    <button type="button" data-proto aria-label="Check out with PayPal" class="flex h-[52px] items-center justify-center rounded bg-[#ffc439] hover:brightness-95">
      <span aria-hidden="true" class="text-lg font-extrabold italic leading-none tracking-tight"><span class="text-[#253b80]">Pay</span><span class="text-[#179bd7]">Pal</span></span>
    </button>
    <button type="button" data-proto aria-label="Check out with Google Pay" class="flex h-[52px] items-center justify-center gap-1 rounded bg-[#1f1f1f] hover:bg-black">
      <svg viewBox="0 0 48 48" class="h-[18px] w-[18px]" aria-hidden="true">
        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
      </svg>
      <span aria-hidden="true" class="text-lg leading-none text-white">Pay</span>
    </button>
  </div>
  {{ co.orDivider() }}
</div>
