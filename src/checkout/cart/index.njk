---
# Cart page, Figma "Cart" (14714:103185) and "Cart - Empty" (21071:135304).
# Lines, totals and the empty state are driven by Alpine.store("cart").
# Phones: "Mobile - Cart" (14714:103652) and "Mobile - Cart - Empty" (21071:135318).
layout: layouts/base.njk
title: Cart
permalink: /checkout/cart/
---
{% import "pdp-cart/graphics.njk" as gfx %}
<div x-data="cartPage" class="container-page flex flex-col gap-4 pb-8 pt-8 md:gap-5 md:pb-20 md:pt-10" data-figma="27290:12068">
  {# Phones: 40x32 back button left of a Medium 28/36 title (14714:103652). #}
  <div class="flex items-center gap-5 md:block">
    <a href="/" @click.prevent="history.length > 1 ? history.back() : (location.href = $el.href)" aria-label="Back"
       class="flex h-8 w-10 shrink-0 items-center justify-center rounded border border-outline bg-secondary-100 text-primary-500 md:hidden">{% icon "chevron-right", "h-6 w-6 rotate-180" %}</a>
    <h1 class="text-mobile-h1 font-medium text-heading md:text-h1 md:font-bold">Cart</h1>
  </div>

  {# Cart - Empty (21071:135310) #}
  <div x-show="$store.cart.items.length === 0" x-cloak class="flex justify-center rounded border border-outline bg-white p-[39px] md:px-6 md:py-[60px]" data-figma="21071:135310">
    <div class="flex max-w-[414px] flex-col items-center gap-6 text-center md:gap-8" data-figma="21071:135311">
      {{ gfx.emptyBox() }}
      <div class="flex flex-col gap-2">
        <h2 class="text-h4 font-medium text-ink md:text-h2 md:font-bold md:text-heading">Your cart is empty</h2>
        <p class="text-base text-body">Looks like you haven&rsquo;t added any products to your cart yet.</p>
      </div>
      {# Phones: full-width buttons stacked 12px apart, 32px under the text (21071:135318). #}
      <div class="mt-2 flex w-full flex-col gap-3 md:mt-0 md:w-auto md:flex-row md:flex-wrap md:justify-center" data-figma="34331:36279">
        <a href="/browse-by-specialty/" class="btn-primary">Start Shopping</a>
        <a href="/quick-order/" x-show="$store.auth.loggedIn" class="btn-secondary px-6 text-base" data-figma="34331:36270">{% icon "checkup-list", "h-6 w-6" %}Order by SKU</a>
      </div>
    </div>
  </div>

  {# Cart with items (27290:12067). Phones (14714:103652): one column, lines, buttons, summary column,
     then the compliance notice last (the left column is display: contents there). #}
  <div x-show="$store.cart.items.length > 0" x-cloak class="grid items-start md:gap-6 xl:grid-cols-[minmax(0,1fr)_288px]" data-figma="27290:12067">
    <div class="contents min-w-0 flex-col gap-6 md:flex" data-figma="14714:103260">
      {% include "pdp-cart/cart-lines.njk" %}
      {% include "pdp-cart/compliance.njk" %}
    </div>
    {% include "pdp-cart/cart-summary.njk" %}
  </div>
</div>
