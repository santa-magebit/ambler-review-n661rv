{#
  Footer: two designs and nothing in between, mobile up to 768px (tablet) and web from 769px.
  Web (Landing Page 34141:38086): white band + 56px navy bottom bar; from 1280px the four columns fill
  the width in the drawn proportions (345 / 223 / 563 / 345) and never get narrower than their content.
  The single row needs about 1200px, so from 769px to 1279px the same columns sit in two rows:
  logo | socials + BBB, then Quick Links | Contact Information.
  Mobile (Figma "mobile/footer" 34739:21934): centred logo, contact buttons, one row per link,
  socials + BBB, copyright only in the bar.
  The logo matches the header's visually: the blue logo on white reads smaller than the white one on
  navy, so it is about 8% taller (56px on web vs the header's 52px, 32px on mobile vs 30px).
#}
{% set mapsHref = "https://www.google.com/maps/search/?api=1&query=" + (site.contact.address | replace("|", "") | urlencode) %}
<footer class="mt-auto" data-figma="34141:38086">
  {# Mobile #}
  <div class="bg-white min-[769px]:hidden" data-figma="34739:21934">
    <div class="flex justify-center py-7">
      <a href="/" aria-label="Ambler Surgical home"><img src="/img/logo.png" alt="Ambler Surgical" width="138" height="32" class="h-8 w-auto"></a>
    </div>
    <div class="flex flex-col gap-2 border-t border-[#dedede] px-4 py-6">
      <a href="{{ site.contact.phoneHref }}" class="btn-accent w-full">{% icon "phone-call" %}{{ site.contact.phone }}</a>
      <a href="mailto:{{ site.contact.email }}" class="btn h-14 w-full border border-[#dedede] bg-white text-primary-500 hover:bg-[#f5f5f5]">{% icon "mail" %}{{ site.contact.email }}</a>
      <a href="{{ mapsHref }}" target="_blank" rel="noreferrer" class="btn h-14 w-full border border-[#dedede] bg-white text-primary-500 hover:bg-[#f5f5f5]">{% icon "map-pin" %}Directions to Ambler</a>
    </div>
    <ul class="border-t border-[#dedede] text-lg text-primary-500">
      {% for l in site.footerQuickLinks %}
      <li class="border-b border-[#dedede]"><a href="{{ l.href }}" class="flex h-[60px] items-center px-4 hover:text-primary-700">{{ l.label }}</a></li>
      {% endfor %}
      <li class="border-b border-[#dedede]"><a href="#" data-proto class="flex h-[60px] items-center px-4 hover:text-primary-700">Privacy Policy</a></li>
      <li class="border-b border-[#dedede]"><a href="#" data-proto class="flex h-[60px] items-center px-4 hover:text-primary-700">Manage Cookies</a></li>
    </ul>
    <div class="flex items-center justify-between gap-3 px-4 py-6">
      <ul class="flex gap-3">
        {# Figma's mobile row: Facebook, LinkedIn, Instagram (no X). #}
        {% for key in ["brand-facebook", "brand-linkedin", "brand-instagram"] %}{% set s = site.social | find("icon", key) %}
        <li>
          <a href="{{ s.href }}" target="_blank" rel="noreferrer" aria-label="{{ s.label }}" class="flex h-[52px] w-[52px] items-center justify-center rounded border border-accent bg-white text-accent hover:bg-accent hover:text-white">{% icon s.icon, "h-6 w-6" %}</a>
        </li>
        {% endfor %}
      </ul>
      <img src="/img/bbb.png" alt="BBB Accredited Business" class="h-auto max-h-[52px] w-auto min-w-0 shrink object-contain">
    </div>
  </div>

  {# Web #}
  <div class="hidden bg-white min-[769px]:block">
    <div class="container-page grid grid-cols-[minmax(max-content,1fr)_minmax(max-content,2fr)] gap-x-5 gap-y-10 py-10 xl:grid-cols-[minmax(max-content,345fr)_minmax(max-content,223fr)_minmax(max-content,563fr)_minmax(max-content,345fr)] xl:gap-5">
      <div class="self-center xl:self-auto">
        <a href="/" aria-label="Ambler Surgical home"><img src="/img/logo.png" alt="Ambler Surgical" width="242" height="56" class="h-14 w-auto"></a>
      </div>
      <div class="row-start-2 xl:row-start-auto">
        <h2 class="text-base font-medium text-ink">Quick Links</h2>
        <ul class="mt-6 flex flex-col gap-2 whitespace-nowrap">
          {% for l in site.footerQuickLinks %}
          <li><a href="{{ l.href }}" class="text-lg text-ink hover:text-primary-500 hover:underline">{{ l.label }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div class="row-start-2 xl:row-start-auto">
        <h2 class="text-base font-medium text-ink">Contact Information</h2>
        <ul class="mt-6 flex flex-col gap-2 whitespace-nowrap text-lg text-primary-500">
          <li><a href="{{ site.contact.phoneHref }}" class="flex items-center gap-2 font-medium hover:underline">{% icon "phone-call", "h-7 w-7 text-accent" %}{{ site.contact.phone }}</a></li>
          <li><a href="mailto:{{ site.contact.email }}" class="flex items-center gap-2 hover:underline">{% icon "mail", "h-7 w-7 text-accent" %}{{ site.contact.email }}</a></li>
          <li class="flex items-center gap-2">{% icon "map-pin", "h-7 w-7 text-accent" %}{{ site.contact.address }}</li>
        </ul>
      </div>
      <div class="col-start-2 row-start-1 flex items-center justify-end gap-6 xl:col-start-auto xl:row-start-auto xl:flex-col xl:items-end xl:justify-start xl:gap-11">
        <ul class="flex gap-3">
          {% for s in site.social %}
          <li>
            <a href="{{ s.href }}" target="_blank" rel="noreferrer" aria-label="{{ s.label }}" class="flex h-[52px] w-[52px] items-center justify-center rounded border border-accent bg-white text-accent hover:bg-accent hover:text-white">{% icon s.icon %}</a>
          </li>
          {% endfor %}
        </ul>
        <img src="/img/bbb.png" alt="BBB Accredited Business" class="h-[52px] w-auto">
      </div>
    </div>
  </div>

  <div class="bg-primary-500 text-base text-white">
    <div class="container-page flex min-h-14 items-center justify-center py-4 min-[769px]:justify-between">
      <p>© 2026 Ambler Surgical</p>
      <p class="hidden items-center gap-2 min-[769px]:flex">
        <a href="#" data-proto class="hover:underline">Privacy Policy</a>
        <span class="h-3 w-px bg-secondary-200" aria-hidden="true"></span>
        <a href="#" data-proto class="hover:underline">Manage Cookies</a>
      </p>
    </div>
  </div>
</footer>
