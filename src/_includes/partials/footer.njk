{# Footer (Landing Page 34141:38086): white band + 56px navy bottom bar. #}
<footer class="mt-auto" data-figma="34141:38086">
  <div class="bg-white">
    <div class="container-page flex flex-col gap-10 py-10 xl:flex-row xl:gap-5">
      <div class="xl:w-[345px] xl:shrink-0">
        <a href="/" aria-label="Ambler Surgical home"><img src="/img/logo.png" alt="Ambler Surgical" class="h-20 w-auto"></a>
      </div>
      <div class="flex flex-1 flex-col gap-10 md:flex-row md:gap-5">
        <div class="md:w-[223px]">
          <h2 class="text-base font-medium text-ink">Quick Links</h2>
          <ul class="mt-6 flex flex-col gap-2">
            {% for l in site.footerQuickLinks %}
            <li><a href="{{ l.href }}" class="text-lg text-ink hover:text-primary-500 hover:underline">{{ l.label }}</a></li>
            {% endfor %}
          </ul>
        </div>
        <div class="min-w-0 flex-1">
          <h2 class="text-base font-medium text-ink">Contact Information</h2>
          <ul class="mt-6 flex flex-col gap-2 text-lg text-primary-500">
            <li><a href="{{ site.contact.phoneHref }}" class="flex items-center gap-2 font-medium hover:underline">{% icon "phone-call", "h-7 w-7 text-accent" %}{{ site.contact.phone }}</a></li>
            <li><a href="mailto:{{ site.contact.email }}" class="flex items-center gap-2 hover:underline">{% icon "mail", "h-7 w-7 text-accent" %}{{ site.contact.email }}</a></li>
            <li class="flex items-center gap-2">{% icon "map-pin", "h-7 w-7 text-accent" %}{{ site.contact.address }}</li>
          </ul>
        </div>
        <div class="flex flex-col items-start gap-11 md:items-end">
          <ul class="flex gap-3">
            {% for s in site.social %}
            <li>
              <a href="{{ s.href }}" target="_blank" rel="noreferrer" aria-label="{{ s.label }}" class="flex h-[52px] w-[52px] items-center justify-center rounded border border-accent bg-white text-accent hover:bg-accent hover:text-white">{% icon s.icon %}</a>
            </li>
            {% endfor %}
          </ul>
          <img src="/img/bbb.png" alt="BBB Accredited Business" class="h-[52px] w-auto">
        </div>
      </div>
    </div>
  </div>
  <div class="bg-primary-500 text-base text-white">
    <div class="container-page flex min-h-14 flex-col justify-between gap-2 py-4 sm:flex-row sm:items-center">
      <p>© 2026 Ambler Surgical</p>
      <p class="flex items-center gap-2">
        <a href="#" data-proto class="hover:underline">Privacy Policy</a>
        <span class="h-3 w-px bg-secondary-200" aria-hidden="true"></span>
        <a href="#" data-proto class="hover:underline">Manage Cookies</a>
      </p>
    </div>
  </div>
</footer>
