    <div class="flex w-full max-w-[886px] flex-col gap-6 md:w-[56%] md:gap-7">
      <h2 class="text-h3 font-medium text-white md:text-h2 md:font-bold">{{ b.title }}{% if b.accent %}<span class="mt-1 block text-accent md:mt-0">{{ b.accent }}</span>{% endif %}</h2>
      <div class="flex flex-col gap-4">
        {% for p in b.paragraphs %}<p class="text-base text-white md:text-lg">{{ p }}</p>{% endfor %}
      </div>
      {% if b.bullets %}
      <ul class="-mt-2 flex flex-col gap-3 md:mt-0 md:gap-2 md:pl-4">
        {% for i in b.bullets %}<li class="flex gap-3 text-base text-white md:gap-4 md:text-lg"><span class="mt-[11px] h-0.5 w-2 shrink-0 rounded-sm bg-accent md:mt-[13px]"></span>{{ i }}</li>{% endfor %}
      </ul>
      {% endif %}
    </div>
  </div>
</section>
{% endmacro %}

{# "Features - list, 2 columns" (34719:11433): title, intro, orange-dash bullets with a bold lead-in. Phones: 16/24, gaps 16. #}
{% macro features(f) %}
<section class="bg-white" data-figma="{{ f.figma }}">
  <div class="container-page pt-8 md:pt-10">
    <div class="flex max-w-[756px] flex-col gap-4 md:gap-3">
      <h2 class="text-h3 font-medium text-heading md:text-h2 md:font-bold">{{ f.title }}</h2>
      <p class="text-base text-body md:text-lg">{{ f.intro }}</p>
    </div>
    <ul class="mt-4 flex max-w-[908px] flex-col gap-4 md:gap-3 md:p-4">
      {% for i in f.items %}
      <li class="flex gap-3 text-base text-body md:text-lg"><span class="mt-[11px] h-0.5 w-2 shrink-0 rounded-sm bg-accent md:mt-[13px]"></span><span><strong class="font-medium text-heading">{{ i[0] }}</strong> &ndash; {{ rich(i[1]) }}</span></li>
      {% endfor %}
