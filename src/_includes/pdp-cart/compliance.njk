{# Cart "regulatory-notice" (34314:11255): 288px grey label panel, three rows split by 1px lines. #}
{% import "pdp-cart/graphics.njk" as gfx %}
{% set cmp = pdpCart.compliance %}
<section aria-labelledby="compliance-title" class="grid overflow-hidden rounded border border-outline bg-white md:grid-cols-[288px_minmax(0,1fr)]" data-figma="34314:11255">
  <div class="flex flex-col gap-3 bg-[#f1f5f9] p-6" data-figma="34314:11256">
    {{ gfx.shield("h-6 w-6 text-heading") }}
    <h2 id="compliance-title" class="text-lg font-medium text-heading">{{ cmp.title }}</h2>
  </div>
  <div class="flex min-w-0 flex-col p-6" data-figma="34314:11259">
    {% for r in cmp.rows %}
    <div class="flex flex-col gap-1 {{ 'mt-5 border-t border-outline pt-5' if not loop.first }}">
      <h3 class="text-base font-bold text-heading">{{ r.title }}</h3>
      <p class="text-sm text-body">{{ r.text }}</p>
    </div>
    {% endfor %}
  </div>
</section>
