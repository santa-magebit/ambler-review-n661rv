{#
  Mini cart drawer (Figma Cart page: "Mini Cart" 21596:85217, "Mini Cart - Added" 34266:78963,
  "Mini Cart - Empty" 21596:85244). 560px panel from the right; state in Alpine.store("cart").
  Phones follow "Mobile - Mini Cart" (21596:85194) / "- Empty" (21596:85269): 56px title bar, 20px sides,
  bin icon at the top right of each line, full-width stacked buttons.
#}
{% import "macros/ui.njk" as ui with context %}
{% import "pdp-cart/graphics.njk" as gfx %}
<div x-show="$store.cart.open" x-cloak class="fixed inset-0 z-50" role="dialog" aria-modal="true" aria-labelledby="minicart-title" @keydown.escape.window="$store.cart.close()" data-figma="34266:78963">
  <div class="absolute inset-0 bg-secondary-700/30" @click="$store.cart.close()" x-show="$store.cart.open" x-transition.opacity></div>
  <div class="absolute inset-y-0 right-0 flex w-full max-w-[560px] flex-col bg-white shadow-top"
       x-show="$store.cart.open" x-transition:enter="transition duration-200 ease-out" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0"
       x-trap="$store.cart.open">
    <div class="flex h-14 shrink-0 items-stretch border-b border-outline md:h-[104px]">
      <h2 id="minicart-title" class="flex flex-1 items-center px-5 text-h3 font-medium tracking-title text-heading md:px-10 md:text-h2">My Cart</h2>
      <button type="button" @click="$store.cart.close()" aria-label="Close cart" class="flex w-14 items-center md:w-[104px] justify-center border-l border-outline text-primary-500 hover:bg-secondary-100">{% icon "close-x", "h-6 w-6" %}</button>
    </div>

    {# Empty #}
    <div x-show="$store.cart.items.length === 0" class="flex flex-1 flex-col items-center justify-center gap-6 px-5 text-center md:px-10">
      {{ gfx.emptyBox() }}
      <div class="max-w-[300px]">
        <p class="text-h4 font-medium tracking-title text-ink md:text-h3">Your cart is empty</p>
        <p class="mt-2 text-base text-body">Looks like you haven&rsquo;t added any products to your cart yet.</p>
      </div>
      {# Start Shopping + Order by SKU side by side (Mini Cart - Empty 34775:25066). #}
      <div class="mt-2 flex w-full flex-col gap-3 md:mt-0 md:w-auto md:flex-row md:flex-wrap md:justify-center">
        <a href="/browse-by-specialty/" class="btn-primary w-full md:w-auto">Start Shopping</a>
        <a href="/quick-order/" x-show="$store.auth.loggedIn" class="btn-secondary w-full px-6 text-base md:w-auto">{% icon "checkup-list", "h-6 w-6" %}Order by SKU</a>
      </div>
    </div>

    {# Lines #}
    <ul x-show="$store.cart.items.length > 0" class="flex-1 overflow-y-auto">
      <template x-for="item in $store.cart.items" :key="item.slug">
        <li class="flex gap-4 border-b border-outline px-5 py-4 md:gap-6 md:px-10 md:py-5" :class="$store.cart.lastAdded === item.slug && 'bg-[#e8f8ea]'">
          <a :href="url(item.product.url)" class="shrink-0"><img :src="url(item.product.image)" alt="" class="h-[108px] w-[108px] rounded border border-outline bg-white object-contain"></a>
          <div class="flex min-w-0 flex-1 flex-col gap-2">
            <div class="flex items-start gap-0">
              <div class="flex min-w-0 flex-1 flex-col gap-1 md:gap-2">
                <a :href="url(item.product.url)" class="text-base text-body hover:text-primary-500 hover:underline"
                   x-text="(item.product.sku ? item.product.sku + ' ' : '') + item.product.name + (item.product.variant ? '' : ', ' + item.product.description)"></a>
                <span x-show="item.product.variant" class="text-xs text-body" x-text="item.product.variant"></span>
                <span class="text-lg font-bold tracking-title text-ink" x-text="money(item.product.price)"></span>
              </div>
              {# Phones: the bin sits at the top right of the line. #}
              <button type="button" @click="$store.cart.remove(item.slug)" :aria-label="'Remove ' + item.product.name" class="flex h-11 w-11 shrink-0 items-center justify-center text-primary-500 hover:text-error md:hidden">{% icon "trash", "h-6 w-6" %}</button>
            </div>
            <div class="flex items-center justify-between gap-4 md:mt-1">
              {{ ui.qtyStepper("item.qty", "v => $store.cart.setQty(item.slug, v)", "Quantity") }}
              <div class="flex text-primary-500">
                <button type="button" data-proto aria-label="Move to wish list" class="flex h-11 w-11 items-center justify-center hover:text-ink">{% icon "heart", "h-6 w-6" %}</button>
                <a :href="url(item.product.url)" :aria-label="'Edit ' + item.product.name" class="flex h-11 w-11 items-center justify-center hover:text-ink">{% icon "pencil", "h-6 w-6" %}</a>
                <button type="button" @click="$store.cart.remove(item.slug)" :aria-label="'Remove ' + item.product.name" class="hidden h-11 w-11 items-center justify-center hover:text-error md:flex">{% icon "trash", "h-6 w-6" %}</button>
              </div>
            </div>
          </div>
        </li>
      </template>
    </ul>
    <div x-show="$store.cart.items.length > 0" class="flex shrink-0 flex-col gap-3 px-5 pb-5 pt-2.5 shadow-bar md:px-10 md:py-8">
      <a href="/checkout/" class="btn-primary w-full" x-text="'Checkout ' + money($store.cart.subtotal)">Checkout</a>
      <a href="/checkout/cart/" class="btn-secondary w-full">View and Edit Cart</a>
    </div>
  </div>
</div>
