{# "Return Policy" band on the PDP (34660:60511): #eff7fd background, policy text on the left,
   "Items that can't be returned" card on the right. #}
{% set rp = pdpCart.pdp.returnPolicy %}
<section aria-labelledby="return-title" class="bg-[#eff7fd] py-10 lg:py-20" data-figma="34660:60511">
  <div class="container-page flex flex-col gap-10">
    <div class="flex flex-wrap items-center justify-between gap-5" data-figma="34660:60512">
      <h2 id="return-title" class="text-h3 font-bold text-heading md:text-h2">{{ rp.title }}</h2>
      <button type="button" data-proto class="btn-secondary">{{ rp.buttonLabel }}</button>
    </div>
    <div class="grid gap-6 lg:grid-cols-[minmax(0,723fr)_minmax(0,789fr)] lg:items-start" data-figma="34660:60596">
      <div class="flex flex-col gap-8 text-lg text-ink">
        <p>{{ rp.intro }}</p>
        {% for b in rp.blocks %}
        <div class="flex flex-col gap-2">
          <h3 class="text-h4 font-medium tracking-title text-heading">{{ b.title }}</h3>
          <p>{{ b.text }}</p>
        </div>
        {% endfor %}
      </div>
      <div class="flex flex-col gap-4 rounded-lg border border-grayscale-200 bg-white p-6 md:p-8" data-figma="34660:60611">
        <h3 class="text-h4 font-medium tracking-title text-heading">{{ rp.notReturnableTitle }}</h3>
        <ul class="flex flex-col gap-2 text-base text-ink">
          {% for item in rp.notReturnable %}
          <li class="flex gap-4"><span class="mt-[11px] h-0.5 w-2 shrink-0 rounded-[1px] bg-accent" aria-hidden="true"></span>{{ item }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>
