      <img src="{{ '8693ed54' | img }}" alt="Free Lifetime Repair" class="col-start-2 row-start-1 -mt-[26px] h-[126px] w-[130px] shrink-0 object-cover md:-my-[74px] md:h-[228px] md:w-[228px] md:-translate-y-2 md:scale-[1.19]">
      <div class="contents md:flex md:flex-1 md:flex-col md:gap-4">
