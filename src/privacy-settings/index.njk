---
layout: account/layout.njk
title: Privacy Settings
permalink: /privacy-settings/
figma: "34385:27016"
---
{% import "account/macros.njk" as acc with context %}
{% set anonymiseText = "By clicking ‘Agree and Proceed’ you agree that your personal data will be replaced with non-personal anonymous information. When you receive a new login email, your email address and all other personal data will be deleted from the website." %}
{% set deleteText = "By clicking ‘Agree and Submit request’ button you agree that all your orders, personal data and other information associated with your account or purchases will be lost. You will not be able to regain access to your account after we approve your deletion request." %}
{% set downloadText = "Here you can download a copy of your personal data which we store for your account in CSV format." %}

{# Modal body: text, optional extra field, Current Password, primary action (disabled until a password
   is typed where Figma draws it disabled), Cancel. #}
{% macro modalBody(name, text, action, requirePassword=true) %}
<form @submit.prevent="confirm" novalidate>
  <div class="flex flex-col gap-7 px-6 py-7 sm:px-10">
    <p class="text-base text-body">{{ text }}</p>
    {{ caller() if caller }}
    {{ acc.passwordField("Current Password", "privacy-password-" + name, "Enter your password to proceed", false, "current-password", 'x-model="password"') }}
  </div>
  <div class="flex flex-col gap-3 px-6 pb-10 sm:px-10">
    <button type="submit" class="btn-primary w-full" {% if requirePassword %}:disabled="!password"{% endif %}>{{ action }}</button>
    <button type="button" @click="close" class="btn-link w-full">Cancel</button>
  </div>
</form>
{% endmacro %}

<div x-data="privacySettings" class="flex flex-col gap-10" data-figma="34385:27041">
  {{ acc.pageTitle("Privacy Settings") }}
  <div class="grid items-start gap-6 xl:grid-cols-2" data-figma="34385:27043">
    {% call acc.infoCard("files", "Policies Text", "34385:27044") %}
    <div class="flex flex-wrap gap-3">
      <a href="#" data-proto class="btn-secondary px-7">Read Privacy Policy</a>
      <a href="#" data-proto class="btn-secondary px-7">Read Cookie Policy</a>
    </div>
    {% endcall %}

    {% call acc.infoCard("download", "Download Personal Data", "34385:27069") %}
    <p class="text-base text-body">{{ downloadText }}</p>
    <button type="button" @click="open('download')" class="btn-secondary w-fit">Download</button>
    {% endcall %}

    {% call acc.infoCard("eye-off", "Anonymise Personal Data", "34385:27078") %}
    <p class="text-base text-body">{{ anonymiseText }}</p>
    <button type="button" @click="open('anonymise')" class="btn-secondary w-fit">Agree and Proceed</button>
    {% endcall %}

    {% call acc.infoCard("trash", "Delete Account", "34385:27086") %}
    <p class="text-base text-body">{{ deleteText }}</p>
    <button type="button" @click="open('delete')" class="btn-secondary w-fit">Agree and Submit Request</button>
    {% endcall %}
  </div>

  {# Modals: "Download Data" 34547:111840, "Anonymise" 34547:110463, "Delete Account" 34547:110787 #}
  {% call acc.modal("privacy-download", "Download Personal Data", "modal === 'download'", "close()", "34547:112157") %}
    {% call modalBody("download", downloadText, "Download", false) %}
      {{ acc.checkbox("Merge into one file", "", "merge") }}
    {% endcall %}
  {% endcall %}
  {% call acc.modal("privacy-anonymise", "Anonymise Personal Data", "modal === 'anonymise'", "close()", "34547:110757") %}
    {{ modalBody("anonymise", anonymiseText, "Agree and Proceed") }}
  {% endcall %}
  {% call acc.modal("privacy-delete", "Delete Account", "modal === 'delete'", "close()", "34547:110834") %}
    {{ modalBody("delete", deleteText, "Agree and Proceed") }}
  {% endcall %}
</div>
