{#
  PDP gallery card (34659:60344): 52px #f5f8fa strip with "Popular" and the item number,
  974x522 main image, 108px thumbnails (active: 2px #3a526d border). The main image opens
  "PDP - Zoom" (21171:386870), teleported to <body> so it sits above the header.
  Expects `product` and `gallery` (image paths) in scope. State: Alpine.data("pdpGallery").
#}
<section x-data="pdpGallery({{ gallery | json }})" aria-label="Product images"
         class="min-w-0 self-start overflow-hidden rounded border border-card bg-white lg:sticky lg:top-[calc(var(--header-h,0px)+24px)]" data-figma="34659:60344">
  <div class="flex min-h-[52px] items-center justify-between gap-2 bg-menu px-5 py-3" data-figma="34659:60345">
    {% if product.badge %}
    <span class="flex items-center gap-1.5 text-base font-medium text-primary-500">{% icon "heart", "h-4 w-4" %}{{ product.badge }}</span>
    {% else %}<span></span>{% endif %}
    {% if product.sku %}<span class="text-lg font-bold text-primary-500">ITEM#: {{ product.sku }}</span>{% endif %}
  </div>

  <div class="flex flex-col gap-5 p-3 sm:p-5" data-figma="34224:49541">
    <button type="button" x-ref="opener" @click="open()" aria-label="Zoom image"
            class="block aspect-[974/522] w-full cursor-zoom-in overflow-hidden rounded border border-outline bg-white">
      <img src="{{ gallery[0] }}" :src="src" alt="{{ product.name }}" class="h-full w-full object-contain">
    </button>
    {% if gallery.length > 1 %}
    <ul class="flex flex-wrap gap-3" aria-label="Product image thumbnails" data-figma="34224:49543">
      {% for img in gallery %}
      <li>
        <button type="button" @click="show({{ loop.index0 }})" aria-label="Show image {{ loop.index }} of {{ gallery.length }}"
                :aria-current="index === {{ loop.index0 }}"
                class="block h-[72px] w-[72px] overflow-hidden rounded bg-white sm:h-[108px] sm:w-[108px]"
                :class="index === {{ loop.index0 }} ? 'border-2 border-card' : 'border border-outline hover:border-card'">
          <img src="{{ img }}" alt="" class="h-full w-full object-contain">
        </button>
      </li>
      {% endfor %}
    </ul>
    {% endif %}
  </div>

  {# PDP - Zoom (21171:386870): white full screen, image centred at full height, 106px thumbnails
     down the left, 104px close box top right. Prev/next buttons and arrow keys added for the prototype. #}
  <template x-teleport="body">
    <div x-show="zoom" x-cloak x-trap="zoom" x-effect="lockScroll('pdp-zoom', zoom)" role="dialog" aria-modal="true" aria-label="{{ product.name }}, enlarged images"
         @keydown.escape.window="zoom && close()" @keydown.arrow-right.window="zoom && many && next()" @keydown.arrow-left.window="zoom && many && prev()"
         class="fixed inset-0 z-50 bg-white" data-figma="21171:386870">
      <img :src="src" alt="{{ product.name }}"
           class="absolute inset-0 m-auto h-full w-full max-w-[939px] object-contain px-4 pb-28 pt-20 md:px-0 md:py-0">

      <ul x-show="many" aria-label="Product image thumbnails" data-figma="21171:386874"
          class="absolute bottom-6 left-1/2 flex -translate-x-1/2 gap-3 md:bottom-auto md:left-10 md:top-10 md:translate-x-0 md:flex-col">
        <template x-for="(img, i) in images" :key="i">
          <li>
            <button type="button" @click="show(i)" :aria-label="'Show image ' + (i + 1) + ' of ' + images.length" :aria-current="index === i"
                    class="block h-16 w-16 overflow-hidden rounded bg-white md:h-[106px] md:w-[106px]"
                    :class="index === i ? 'border-2 border-primary-500' : 'border border-outline hover:border-primary-500'">
              <img :src="img" alt="" class="h-full w-full object-contain">
            </button>
          </li>
        </template>
      </ul>

      <template x-if="many">
        <div>
          <button type="button" @click="prev()" aria-label="Previous image"
                  class="btn-secondary absolute left-4 top-1/2 w-[52px] -translate-y-1/2 px-0 md:left-[186px]">{% icon "arrow-left" %}</button>
          <button type="button" @click="next()" aria-label="Next image"
                  class="btn-secondary absolute right-4 top-1/2 w-[52px] -translate-y-1/2 px-0 md:right-10">{% icon "arrow-right" %}</button>
        </div>
      </template>

      <button type="button" @click="close()" aria-label="Close enlarged images" data-figma="21171:386872"
              class="absolute right-0 top-0 flex h-16 w-16 items-center justify-center border-b border-l border-outline bg-white text-primary-500 hover:bg-secondary-100 md:h-[104px] md:w-[104px]">
        {% icon "close-x", "h-6 w-6" %}
      </button>
    </div>
  </template>
</section>
