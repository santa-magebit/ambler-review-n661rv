---
layout: layouts/base.njk
pagination:
  data: plp.browseTypes
  size: 1
  alias: bt
permalink: "{{ bt.url }}"
eleventyComputed:
  title: "{{ bt.name | safe }}"
---
{#- Browse by Type > <Type>: Figma "PLP - Type Page - Forceps - 1920px" (34887:118658). The product listing
    below "Browse by Name" is the shared listing from the Product Type Page (34723:17181). -#}
{% import "macros/ui.njk" as ui with context %}
{% import "plp/macros.njk" as plp_ui with context %}

{{ ui.breadcrumbs(bt.breadcrumbs) }}
{{ plp_ui.hero(bt.hero, "34888:121768") }}

{% if bt.subtypes.length %}
{# Browse by Type (sub-types are not part of the prototype) #}
<section class="bg-white" data-figma="34887:119131">
  <div class="container-page pb-5 pt-10">
    {% set subItems = [] %}
    {% for s in bt.subtypes %}{% set subItems = (subItems.push({ label: s.name, href: "#" }), subItems) %}{% endfor %}
    {% call plp_ui.titleRow("Browse by Type") %}{{ plp_ui.quickSelect(subItems, "All Types", "34887:119134", true) }}{% endcall %}
    <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-figma="34887:119137">
      {% for s in bt.subtypes %}
      <li class="min-w-0">{{ plp_ui.categoryCard({ name: s.name, href: "#", image: s.image, fit: s.fit or "cover", style: s.style, hover: s.hover, proto: true }, "34887:119138") }}</li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{% if bt.names.length %}
{# Browse by Name: filters the listing below #}
<section class="bg-white" data-figma="34887:119142">
  <div class="container-page {{ 'pt-5' if bt.subtypes.length else 'pt-10' }}">
    {% set nameItems = [] %}
    {% for n in bt.names %}{% set nameItems = (nameItems.push({ label: n.name, href: "?name=" + (n.name | urlencode), filter: n.key }), nameItems) %}{% endfor %}
    {% call plp_ui.titleRow("Browse by Name", "md") %}{{ plp_ui.quickSelect(nameItems, "All Names", "34887:119145") }}{% endcall %}
    <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-figma="34887:119148">
      {% for n in bt.names %}
      <li class="min-w-0">
        <a href="?name={{ n.name | urlencode }}" @click.prevent="$dispatch('plp-filter', '{{ n.key }}')" class="flex h-[58px] items-center justify-between gap-3 rounded border border-primary-500 bg-[#f5f7fa] px-5 text-primary-500 hover:bg-primary-500 hover:text-white" data-figma="34887:120029">
          <span class="flex min-w-0 items-baseline gap-2"><span class="truncate text-h3 font-medium">{{ n.name }}</span><span class="text-base opacity-80">({{ n.count }})</span></span>
          {% icon "arrow-narrow-right", "h-6 w-6" %}
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{{ plp_ui.listing(bt.listing, "34723:17181") }}
{% if bt.band %}{{ plp_ui.infoBand(bt.band) }}{% endif %}
{% if bt.seo %}
<section class="bg-[#f5f7fa]" data-figma="{{ bt.seo.figma }}">
  <div class="container-page pb-5 pt-10">
    <h2 class="text-h3 font-bold text-heading md:text-h2">{{ bt.seo.title }}</h2>
    <div class="mt-6 flex max-w-[856px] flex-col gap-4">{% for p in bt.seo.paragraphs %}<p class="text-lg text-body">{{ p }}</p>{% endfor %}</div>
  </div>
</section>
{% endif %}
{{ plp_ui.faq(plp.faq.general, "34887:118753", "wide", "#f5f7fa", "pt-5" if bt.seo else "pt-10") }}
