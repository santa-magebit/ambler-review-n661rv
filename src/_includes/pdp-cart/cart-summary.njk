{#
  Cart summary column (14714:103199), 288px: Summary box with toggles and totals,
  checkout buttons with PayPal / Google Pay and "We Accept", "Have questions?" box.
  Gift card and discount panels use the checkout's "Apply Discount Code" field design
  (Checkout 34799:87986). State: Alpine.data("cartPage").
#}
{% import "macros/ui.njk" as ui with context %}
{% import "pdp-cart/graphics.njk" as gfx %}
{% set row = "flex min-h-14 w-full items-center justify-between gap-2 border-t border-outline px-6 py-4 text-left text-base text-heading hover:text-primary-500" %}
<aside aria-label="Order summary" class="flex flex-col gap-6" data-figma="14714:103199">
  <div class="overflow-hidden rounded bg-secondary-100" data-figma="14714:103200">
    <h2 class="flex h-16 items-center px-6 text-h3 font-medium text-heading">Summary</h2>

    <button type="button" data-proto class="{{ row }}" data-figma="14714:103204">
      Estimate shipping and Tax {% icon "dropdown", "h-6 w-6" %}
    </button>

    <dl class="flex flex-col gap-2 border-t border-outline px-6 py-5 text-base text-body" data-figma="14714:103208">
      <div class="flex justify-between gap-3"><dt>Subtotal</dt><dd x-text="money($store.cart.subtotal)"></dd></div>
      <div class="flex justify-between gap-3"><dt>Discount</dt><dd x-text="'- ' + money(discount)"></dd></div>
      <div class="flex justify-between gap-3 text-lg font-bold tracking-title text-ink"><dt>Grand Total</dt><dd x-text="money(grandTotal)"></dd></div>
    </dl>

    <button type="button" @click="toggle('gift')" :aria-expanded="panel === 'gift'" aria-controls="cart-gift" class="{{ row }}" data-figma="14714:103219">
      Use Gift Card
      <span x-show="panel !== 'gift'">{% icon "dropdown", "h-6 w-6" %}</span>
      <span x-show="panel === 'gift'" x-cloak>{% icon "dropdown-up", "h-6 w-6" %}</span>
    </button>
    <form id="cart-gift" x-show="panel === 'gift'" x-collapse x-cloak @submit.prevent class="flex flex-col gap-4 px-6 pb-6">
      {{ ui.field("Gift Card Code", "giftcard_code", placeholder="Enter gift card code") }}
      <button type="submit" data-proto class="btn-secondary w-full">Apply</button>
    </form>

    <button type="button" @click="toggle('discount')" :aria-expanded="panel === 'discount'" aria-controls="cart-discount" class="{{ row }}" data-figma="34266:81982">
      Apply Discount Code
      <span x-show="panel !== 'discount'">{% icon "dropdown", "h-6 w-6" %}</span>
      <span x-show="panel === 'discount'" x-cloak>{% icon "dropdown-up", "h-6 w-6" %}</span>
    </button>
    <form id="cart-discount" x-show="panel === 'discount'" x-collapse x-cloak @submit.prevent class="flex flex-col gap-4 px-6 pb-6">
      {{ ui.field("Discount Code", "coupon_code", placeholder="Enter discount code") }}
      <button type="submit" data-proto class="btn-secondary w-full">Apply</button>
    </form>
  </div>

  <div class="flex flex-col gap-3" data-figma="14714:103222">
    <a href="/checkout/" class="btn-primary w-full">Proceed To Checkout</a>
    <div class="flex items-center gap-3 text-sm text-body" aria-hidden="true"><span class="h-px flex-1 bg-outline"></span>Or<span class="h-px flex-1 bg-outline"></span></div>
    <button type="button" data-proto aria-label="Pay with PayPal" class="flex h-[52px] w-full items-center justify-center rounded bg-[#ffc439] hover:brightness-95">{{ gfx.paypal() }}</button>
    <button type="button" data-proto aria-label="Pay with Google Pay" class="flex h-[52px] w-full items-center justify-center rounded bg-[#1f1f1f] hover:bg-black">{{ gfx.gpay() }}</button>
    <div class="relative mt-3 flex justify-center rounded border border-outline pb-6 pt-6" data-figma="14714:103246">
      <span class="absolute left-1/2 top-0 -translate-x-1/2 -translate-y-1/2 bg-white px-3 text-sm text-ink">We Accept</span>
      {{ gfx.cardBadges() }}
    </div>
  </div>

  <div class="flex flex-col gap-5 rounded bg-secondary-100 p-6" data-figma="14714:103255">
    <p class="text-base text-ink">Have questions?<br><span class="text-body">Expert help just one click away</span></p>
    <a href="/contact/" class="btn-secondary w-full">Contact Us</a>
  </div>
</aside>
