{# "why us?" row (34777:59023). Phones (34777:58812): #f5f8fa band, 60px circles with 32px icons, navy titles. #}
{% macro trustRow() %}
<section class="bg-[#f5f8fa] md:bg-white" aria-label="Why Ambler Surgical" data-figma="34777:59023">
  <ul class="container-page grid gap-5 py-8 sm:grid-cols-2 md:gap-6 md:py-10 xl:grid-cols-4">
