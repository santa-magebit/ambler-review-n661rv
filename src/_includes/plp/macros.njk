{#
  Product line tile (styleguide "Brands cards" 14714:57265): 80px, #3a526d border, logo or name.
  compact: 61px tall with logos at 72% on phones ("Shop by Product Lines" 34777:58812).
#}
{% macro logoTile(b, compact=false) %}
<a href="{{ b.url }}" class="card-hover flex {{ 'h-[61px] md:h-20' if compact else 'h-20' }} items-center justify-center rounded border border-card bg-white px-3 text-center hover:border-primary-500">
  {% if b.logo and compact %}
  <img src="{{ b.logo }}" alt="{{ b.name }}" loading="lazy" class="max-h-[34px] w-[calc(var(--w)*0.72)] max-w-full object-contain md:max-h-12 md:w-[var(--w)]" style="--w: {{ plp.logoWidths[b.slug] or 160 }}px">
  {% elif b.logo %}
  <img src="{{ b.logo }}" alt="{{ b.name }}" loading="lazy" class="max-h-12 max-w-full object-contain" style="width: {{ plp.logoWidths[b.slug] or 160 }}px">
  {% else %}
  <span class="text-lg font-medium leading-6 text-primary-500">{{ b.name }}</span>
  {% endif %}
</a>
{% endmacro %}

{#
  FAQ (34777:59083): accordion + "Can't find your answer?" box.
  items: [{ q, a? }]; all questions start closed. Questions without a drawn answer are prototype gaps.
  layout: "wide" (971 + 525, gap 40) or "narrow" (886 + 590, gap 60).
  Phones (34777:58812): the "Can't find your answer?" box is a full-width navy band closing the section.
  pt: top padding classes (phone and md:).
#}
{% macro faq(items, figma, layout="wide", tint="#f5f8fa", pt="pt-8 md:pt-10") %}
<section style="background-color: {{ tint }}" data-figma="{{ figma }}">
  <div class="container-page {{ pt }} md:pb-10">
    <h2 class="text-h3 font-medium text-heading md:text-h2 md:font-bold">Frequently Asked Questions</h2>
    <div class="{{ 'mt-4 gap-8 md:mt-10 md:gap-10 lg:grid-cols-[minmax(0,971fr)_minmax(0,525fr)]' if layout == 'wide' else 'mt-4 gap-8 md:mt-8 md:gap-10 lg:grid-cols-[minmax(0,886fr)_minmax(0,590fr)] lg:gap-[60px]' }} grid items-start" x-data="{ open: null }">
      <div>
        {% for i in items %}
        {% set n = loop.index0 %}
        <div class="border-b border-secondary-200 py-4">
          <h3>
            <button type="button" {% if i.a %}@click="open = open === {{ n }} ? null : {{ n }}" :aria-expanded="open === {{ n }}" aria-controls="faq-{{ figma | slugify }}-{{ n }}"{% else %}data-proto{% endif %}
                    class="flex w-full items-center justify-between gap-3 text-left text-lg font-medium" :class="open === {{ n }} ? 'text-accent' : 'text-ink hover:text-primary-500'">
              {{ i.q }}
              <span x-show="open !== {{ n }}">{% icon "dropdown", "h-6 w-6 text-ink" %}</span>
              <span x-show="open === {{ n }}" x-cloak>{% icon "dropdown-up", "h-6 w-6 text-accent" %}</span>
            </button>
          </h3>
          {% if i.a %}
          <div id="faq-{{ figma | slugify }}-{{ n }}" x-show="open === {{ n }}" x-collapse x-cloak>
            <div class="flex flex-col gap-3 pt-3">{% for p in i.a %}<p class="text-lg text-body">{{ p }}</p>{% endfor %}</div>
          </div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      <div class="-mx-5 flex flex-col gap-6 bg-primary-500 px-5 py-8 md:mx-0 md:rounded md:p-7">
        <div class="flex flex-col gap-4">
          <h3 class="text-h3 font-medium text-white md:text-h2 md:font-bold">Can&rsquo;t find your answer?</h3>
          <p class="text-base text-[#d3dce5] md:text-lg">Our instrument specialists respond within one business day.</p>
        </div>
        <a href="/contact/" class="btn-accent pl-8 pr-[30px] md:self-start">Contact Our Team{% icon "arrow-narrow-right" %}</a>
      </div>
    </div>
  </div>
</section>
{% endmacro %}
