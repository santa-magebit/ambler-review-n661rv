{#
  Header: two designs and nothing in between, switching at 1280px (xl), where the five links fit.
  Web (Landing Page 34141:37898): 120px navy bar with a 3px orange bottom border (logo, search,
  Quick Order, phone), then an 88px white bar (navigation, My Account, Cart). Shadow 0 5 10 #1f29371a.
  Mobile (styleguide "HEADER MOBILE" 34739:21830, signed in 34741:28374): 40px phone row, 52px navy row
  (menu, logo, Quick Order when signed in, account, orange cart), 52px search row.
  State lives in Alpine.data("siteHeader") in assets/js/app.js.
#}
{# My Account dropdown (Figma "Log In - Dropdown" 34194:128259 and "Logged In - Dropdown" 34194:128201), used by both layouts. #}
{% set accountMenu %}
<div x-show="menu === 'account'" x-cloak x-transition.opacity class="absolute right-0 top-full z-50 mt-0.5 overflow-hidden rounded bg-white shadow-300">
  <ul x-show="$store.auth.loggedIn" class="w-[320px]" data-figma="34194:128204">
    {% for n in site.accountNav %}
    <li>
      <a href="{{ n.href }}" class="flex h-[52px] items-center gap-3 border-b border-outline px-5 text-lg font-medium text-body hover:bg-[#f5f5f5] hover:text-primary-500">
        {% icon n.icon, "h-7 w-7 text-primary-500" %}{{ n.label }}
      </a>
    </li>
    {% endfor %}
    <li>
      <button type="button" @click="$store.auth.signOut(); window.location.href = url('/customer/account/logoutSuccess/')" class="flex h-[52px] w-full items-center gap-3 px-5 text-lg font-medium text-body hover:bg-[#f5f5f5] hover:text-primary-500">
        {% icon "door-exit", "h-7 w-7 text-primary-500" %}Sign Out
      </button>
    </li>
  </ul>
  <div x-show="!$store.auth.loggedIn" class="flex w-[340px] flex-col gap-7 py-10" data-figma="34194:128263">
    <div class="flex flex-col gap-3 px-10">
      <p class="text-h4 font-medium tracking-title text-heading">Authorize</p>
      <a href="/customer/account/login/" class="btn-primary">Sign In</a>
    </div>
    <hr class="border-outline">
    <div class="flex flex-col gap-3 px-10">
      <p class="text-h4 font-medium tracking-title text-heading">Don&rsquo;t have account?</p>
      <a href="/customer/account/create/" class="btn-secondary">Create an Account</a>
    </div>
  </div>
</div>
{% endset %}
{# Phones (Figma "Mobile - Log In - Dropdown" 34194:128271, "Mobile - My Account" 34194:128215): a 240px card
   when signed out, a full-screen panel with 60px rows when signed in. #}
{% set accountMenuMobile %}
<div x-show="menu === 'account' && !$store.auth.loggedIn" x-cloak x-transition.opacity class="absolute right-1 top-full z-50 mt-2 flex w-[240px] flex-col gap-3 rounded bg-white py-5 text-left shadow-300" data-figma="34194:128271">
  <div class="flex flex-col gap-3 px-5">
    <p class="text-lg font-medium text-heading">Authorize</p>
    <a href="/customer/account/login/" class="btn-primary px-4">Sign In</a>
  </div>
  <hr class="border-outline">
  <div class="flex flex-col gap-3 px-5">
    <p class="text-lg font-medium text-heading">Don&rsquo;t have account?</p>
    <a href="/customer/account/create/" class="btn-secondary whitespace-nowrap px-4">Create an Account</a>
  </div>
</div>
<div x-show="menu === 'account' && $store.auth.loggedIn" x-cloak x-effect="lockScroll('account-panel', menu === 'account' && $store.auth.loggedIn && innerWidth < 1280)"
     class="fixed inset-0 z-50 flex flex-col bg-white text-left" role="dialog" aria-modal="true" aria-label="My Account" data-figma="34194:128215">
  <div class="flex h-14 shrink-0 items-stretch border-b border-outline">
    <p class="flex flex-1 items-center px-5 text-h3 font-medium tracking-title text-heading">My Account</p>
    <button type="button" @click="menu = null" aria-label="Close My Account" class="flex w-14 items-center justify-center border-l border-outline text-primary-500 hover:bg-secondary-100">{% icon "close-x", "h-6 w-6" %}</button>
  </div>
  <ul class="flex-1 overflow-y-auto">
    {% for n in site.accountNav %}
    <li class="border-b border-secondary-200"><a href="{{ n.href }}" class="flex h-[60px] items-center gap-3 px-5 text-lg font-medium text-body hover:bg-[#f5f5f5] hover:text-primary-500">{% icon n.icon, "h-7 w-7" %}{{ n.label }}</a></li>
    {% endfor %}
    <li class="border-b border-secondary-200">
      <button type="button" @click="$store.auth.signOut(); window.location.href = url('/customer/account/logoutSuccess/')" class="flex h-[60px] w-full items-center gap-3 px-5 text-lg font-medium text-body hover:bg-[#f5f5f5] hover:text-primary-500">{% icon "door-exit", "h-7 w-7" %}Sign Out</button>
    </li>
  </ul>
</div>
{% endset %}
{# Cart item count: styleguide "With Items" (14714:56856), a white tab in the button's top-right corner (corners 0 / 3 / 0 / 4). #}
{% set cartCount %}<span x-show="$store.cart.count > 0" x-cloak x-text="$store.cart.count" class="absolute right-0.5 top-0.5 flex h-5 min-w-[22px] items-center justify-center rounded-bl rounded-tr-[3px] bg-white p-0.5 text-xs font-bold text-accent group-hover:text-accent-dark"></span>{% endset %}
{# Sticky at every width: the Figma "sticky sub-nav" examples (web 34971:56679, mobile 34971:56818) keep the header on screen while scrolled. #}
<header x-data="siteHeader" @keydown.escape.window="menu = null" @click.outside="menu = null" class="sticky top-0 z-40 bg-white shadow-100" data-figma="34141:37898">
  {# Mobile #}
  <div class="xl:hidden" data-figma="34739:21830">
    <a href="{{ site.contact.phoneHref }}" class="flex h-10 items-center justify-center gap-1 border-t-2 border-accent bg-white text-lg font-semibold leading-6 tracking-[0.1em] text-primary-500">{% icon "phone-call", "h-6 w-6 text-accent" %}{{ site.contact.phone }}</a>
    <div class="flex h-[52px] items-center bg-primary-500 text-white">
      <button type="button" @click="drawer = true" aria-label="Open menu" class="flex h-[52px] w-[52px] shrink-0 items-center justify-center">
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round"/></svg>
      </button>
      <a href="/" class="ml-2 min-w-0 shrink" aria-label="Ambler Surgical home"><img src="/img/logo-header.png" alt="Ambler Surgical" class="h-[30px] w-auto max-w-full object-contain object-left"></a>
      <div class="ml-auto flex">
        <a href="/quick-order/" x-show="$store.auth.loggedIn" aria-label="Quick Order" class="flex h-[52px] w-[52px] items-center justify-center hover:bg-white/10">{% icon "checkup-list", "h-6 w-6" %}</a>
        <div class="relative">
          <button type="button" @click="toggle('account')" :aria-expanded="menu === 'account'" aria-label="My Account" class="flex h-[52px] w-[52px] items-center justify-center hover:bg-white/10" :class="menu === 'account' && 'bg-white/10'">{% icon "user", "h-6 w-6" %}</button>
          {{ accountMenuMobile | safe }}
        </div>
        <button type="button" @click="menu = null; $store.cart.open = true" aria-label="Cart" class="group relative flex h-[52px] w-[52px] items-center justify-center bg-accent hover:bg-accent-dark">{% icon "shopping-cart", "h-6 w-6" %}{{ cartCount | safe }}</button>
      </div>
    </div>
    {% set searchMobile = true %}{% include "partials/search.njk" %}{% set searchMobile = false %}
  </div>

  {# Web #}
  <div class="hidden xl:block">
    {# Actions bar #}
    <div class="border-b-[3px] border-accent bg-primary-500">
      <div class="container-page flex h-[120px] items-center gap-[60px] py-6">
        <a href="/" class="shrink-0" aria-label="Ambler Surgical home">
          {# Exported as rendered: the header logo has a +1 exposure filter in Figma. #}
          <img src="/img/logo-header.png" alt="Ambler Surgical" class="h-[52px] w-auto">
        </a>
        <div class="flex-1">{% include "partials/search.njk" %}</div>
        {# Quick Order link: drawn in the Quick Order frames' header (34391:65511), next to the phone; signed-in customers only. #}
        <div class="ml-auto flex items-center gap-8">
          <a href="/quick-order/" x-show="$store.auth.loggedIn" class="flex items-center gap-3 text-h3 font-semibold text-white hover:underline" data-figma="34391:65511">
            {% icon "checkup-list", "h-7 w-7 text-accent" %}Quick Order
          </a>
          <a href="{{ site.contact.phoneHref }}" class="flex items-center gap-3 text-h3 font-semibold text-white">
            {% icon "phone-call", "h-7 w-7 text-accent" %}{{ site.contact.phone }}
          </a>
        </div>
      </div>
    </div>

    {# Links bar. The five links need ~1390px on one line next to My Account and Cart, so My Account is icon-only below 1400px. #}
    <nav aria-label="Main" class="relative">
      <div class="container-page flex h-[88px] items-center justify-between gap-6">
        <ul class="flex items-center gap-6">
          {% for item in site.mainNav %}
          <li class="flex">
            {% if item.menu %}
            <button type="button" @click="toggle('{{ item.menu }}')" @mouseenter="menu && (menu = '{{ item.menu }}')" :aria-expanded="menu === '{{ item.menu }}'"
                    class="flex items-center gap-1 text-lg font-medium"
                    :class="menu === '{{ item.menu }}' ? 'text-accent' : 'text-primary-500 hover:text-accent'">
              {{ item.label }}
              <span x-show="menu !== '{{ item.menu }}'">{% icon "dropdown" %}</span>
              <span x-show="menu === '{{ item.menu }}'" x-cloak>{% icon "dropdown-up" %}</span>
            </button>
            {% else %}
            <a href="{{ item.href }}" class="text-lg font-medium text-primary-500 hover:text-accent">{{ item.label }}</a>
            {% endif %}
          </li>
          {% endfor %}
        </ul>

        <div class="ml-auto flex items-center gap-3">
          {# My Account (Figma "Log In - Dropdown" 34194:128259 and "Logged In - Dropdown" 34194:128201) #}
          <div class="relative">
            <button type="button" @click="toggle('account')" :aria-expanded="menu === 'account'" aria-label="My Account"
                    class="flex h-[52px] items-center gap-2 rounded px-3 text-lg font-medium text-primary-500 min-[1400px]:px-[30px]"
                    :class="menu === 'account' ? 'bg-ink/5' : 'hover:bg-ink/5'">
              {% icon "user" %}<span class="hidden min-[1400px]:inline">My Account</span>
              <span x-show="menu !== 'account'">{% icon "dropdown" %}</span>
              <span x-show="menu === 'account'" x-cloak>{% icon "dropdown-up" %}</span>
            </button>
            {{ accountMenu | safe }}
          </div>

          {# Cart: opens the mini cart drawer. Item count: styleguide "With Items" (14714:56856), a white
             tab in the button's top-right corner (corners 0 / 3 / 0 / 4) in the button colour. #}
          <button type="button" @click="menu = null; $store.cart.open = true" class="group relative flex h-[52px] items-center gap-2 rounded bg-accent pl-[30px] pr-8 text-lg font-medium text-white hover:bg-accent-dark">
            {% icon "shopping-cart" %}Cart
            {{ cartCount | safe }}
          </button>
        </div>
      </div>

      {# Mega menu (Figma "Megamenu - <Specialty>" frames, e.g. 34447:60218): specialty rail + group columns.
         Laid out in the page container so the rail lines up with the header content; the background
         is white on the left half and #f5f8fa on the right so both colours run to the window edges.
         It never runs past the bottom of the window (the header is sticky): taller menus scroll inside. #}
      <div x-show="menu === 'specialties'" x-cloak x-data="megaMenu('{{ catalog.specialties[0].slug }}')" @mousemove="track($event)" class="absolute inset-x-0 top-full max-h-[calc(100vh-var(--header-h,0px))] overflow-y-auto overscroll-contain border-t border-secondary-200 bg-[linear-gradient(to_right,theme(colors.white)_50%,theme(colors.menu)_50%)] shadow-100" data-figma="34503:13347">
        <div class="container-page flex">
          <div x-ref="rail" @mouseleave="cancel()" class="w-[240px] shrink-0 bg-white py-10 pr-10">
            <ul class="flex w-[200px] flex-col gap-2">
              {% for s in catalog.specialties %}
              <li>
                <a href="{{ s.url }}" @mouseenter="aim('{{ s.slug }}')" @focus="cancel(); active = '{{ s.slug }}'"
                   class="flex items-center gap-1 text-lg font-medium" :class="active === '{{ s.slug }}' ? 'text-accent' : 'text-primary-500 hover:text-accent'">
                  {{ s.name }}<span x-show="active === '{{ s.slug }}'">{% icon "chevron-right" %}</span>
                </a>
              </li>
              {% endfor %}
            </ul>
          </div>
          <div class="min-w-0 flex-1 border-l border-secondary-200 bg-menu py-10 pl-10 pr-4">
            {% for s in catalog.specialties %}
            <div x-show="active === '{{ s.slug }}'" {% if not loop.first %}x-cloak{% endif %}>
              {# Titles and links stay on one line; columns drop to the next row below 240px (the widest title).
                 Gap 40 as drawn at 1536+, 32 below so 1440 still fits four columns. #}
              <div class="grid max-w-[1256px] grid-cols-[repeat(auto-fill,minmax(240px,1fr))] gap-x-8 gap-y-10 2xl:gap-x-10">
                {% for g in s.groups %}
                <div class="flex flex-col gap-4">
                  <a href="{{ s.url }}instruments/" class="flex items-center gap-1 whitespace-nowrap text-lg font-extrabold text-primary-500 hover:underline">{{ g.title }}{% icon "arrow-narrow-right", "h-6 w-6" %}</a>
                  <ul class="flex flex-col gap-2">
                    {% for it in g.items %}
                    <li><a href="{{ s.url }}instruments/{{ it | slugify }}/" class="whitespace-nowrap text-lg text-primary-500 hover:underline">{{ it }}</a></li>
                    {% endfor %}
                  </ul>
                </div>
                {% endfor %}
              </div>
              <a href="{{ s.url }}" class="mt-10 inline-flex items-center gap-1 text-lg font-medium text-primary-500 hover:underline">{{ s.viewAllLabel }}{% icon "arrow-narrow-right", "h-6 w-6" %}</a>
            </div>
            {% endfor %}
          </div>
        </div>
      </div>

      {# The other menus are not drawn in Figma; they reuse the mega menu panel styling. #}
      {% set lists = [
        { key: "productLines", title: "Product Lines", all: "/product-lines/", allLabel: "View All Product Lines" },
        { key: "sterilization", title: "Sterilization Products", all: "/sterilization-cleaning/", allLabel: "View All Sterilization Products" },
        { key: "repair", title: "Repair Services", all: "/repair-services/", allLabel: "View All Repair Services" }
      ] %}
      {% for l in lists %}
      <div x-show="menu === '{{ l.key }}'" x-cloak class="absolute inset-x-0 top-full border-t border-secondary-200 bg-menu shadow-100">
        <div class="container-page py-10">
          <p class="mb-4 text-lg font-extrabold text-primary-500">{{ l.title }}</p>
          <ul class="grid grid-cols-4 gap-x-10 gap-y-2">
            {% if l.key == "productLines" %}
              {% for b in catalog.productLines %}<li><a href="{{ b.url }}" class="text-lg text-primary-500 hover:underline">{{ b.name }}</a></li>{% endfor %}
            {% elif l.key == "sterilization" %}
              {% for s in catalog.sterilization %}<li><a href="{{ s.href }}" data-proto class="text-lg text-primary-500 hover:underline">{{ s.name }}</a></li>{% endfor %}
            {% else %}
              {% for s in catalog.repairServices %}<li><a href="{{ s.href }}" class="text-lg text-primary-500 hover:underline">{{ s.name }}</a></li>{% endfor %}
              <li><a href="/free-lifetime-repair/" class="text-lg text-primary-500 hover:underline">Free Lifetime Repair</a></li>
            {% endif %}
          </ul>
          <a href="{{ l.all }}" class="mt-8 inline-flex items-center gap-1 text-lg font-medium text-primary-500 hover:underline">{{ l.allLabel }}{% icon "arrow-narrow-right", "h-6 w-6" %}</a>
        </div>
      </div>
      {% endfor %}
    </nav>
  </div>

  {# Menu drawer for the mobile header (opened by its menu button). #}
  <div x-show="drawer" x-cloak class="fixed inset-0 z-50 xl:hidden" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="absolute inset-0 bg-secondary-700/40" @click="drawer = false"></div>
    <div class="absolute inset-y-0 left-0 flex w-80 max-w-[85%] flex-col overflow-y-auto bg-white" x-trap="drawer" x-effect="lockScroll('menu-drawer', drawer)">
      <div class="flex h-16 items-center justify-between bg-primary-500 px-4 text-white">
        <span class="font-medium">Menu</span>
        <button type="button" @click="drawer = false" aria-label="Close menu" class="p-2">{% icon "close-x" %}</button>
      </div>
      <ul class="divide-y divide-outline">
        {% for item in site.mainNav %}
        <li><a href="{{ item.href }}" class="flex items-center justify-between px-4 py-4 text-lg font-medium text-primary-500">{{ item.label }}{% icon "chevron-right" %}</a></li>
        {% endfor %}
        <li><a href="{{ site.contact.phoneHref }}" class="flex items-center gap-3 px-4 py-4 text-lg font-medium text-primary-500">{% icon "phone-call", "h-7 w-7 text-accent" %}{{ site.contact.phone }}</a></li>
      </ul>
    </div>
  </div>
</header>
