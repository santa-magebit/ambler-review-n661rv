---
layout: layouts/base.njk
title: Customer Login
permalink: /customer/account/login/
---
{% import "account/macros.njk" as acc with context %}
{# Figma "Login" 14714:118247; phones "Mobile - Login" 14714:118308: back button + Medium 28/36 title on the
   left, 32px padding and gaps, 12px between the cards, 24px card padding with 16px gaps, 20/28 headings. #}
<div class="container-page flex flex-col items-center gap-8 pb-8 pt-8 md:gap-10 md:pb-20 md:pt-10" data-figma="27289:94768">
  <div class="flex w-full items-center gap-5 md:w-auto">
    {{ acc.backButton("/") }}
    <h1 class="text-mobile-h1 font-medium tracking-title text-heading md:text-center md:text-h1 md:font-bold md:tracking-normal">Customer Login</h1>
  </div>
  <div class="grid w-full max-w-[1016px] items-start gap-3 md:grid-cols-2 md:gap-6" data-figma="14714:118252">

    {# Registered Customers #}
    <section class="flex flex-col gap-4 rounded bg-secondary-100 p-6 sm:p-10 md:gap-6" aria-labelledby="login-registered" data-figma="14714:118253">
      <div class="flex max-w-[376px] flex-col gap-1">
        <h2 id="login-registered" class="text-h4 font-medium tracking-title text-heading md:text-h3 md:tracking-normal">Registered Customers</h2>
        <p class="text-base text-body">If you have an account, sign in with your email address.</p>
      </div>
      <form x-data="accountAuthForm('', true)" @submit.prevent="submit" novalidate class="flex flex-col gap-7">
        <div x-show="error" x-cloak>{{ acc.alert("The account sign-in was incorrect or your account is disabled temporarily. Please wait and try again later.", "error") }}</div>
        <div>
          <label for="login-email" class="label">E-mail</label>
          <input id="login-email" name="email" type="email" autocomplete="email" required placeholder="Enter your email" class="input">
        </div>
        {{ acc.passwordField("Password", "login-password", "Enter your password", false, "current-password", "required") }}
        <div class="flex flex-col gap-3">
          <button type="submit" class="btn-primary w-full">Sign In</button>
          <a href="/customer/account/forgotpassword/" class="btn-link w-full">Forgot Your Password?</a>
        </div>
        {# Prototype helper, not part of the design: the mock account to sign in with (site.testAccount). #}
        <div class="flex flex-col gap-2 rounded border border-dashed border-secondary-400 bg-white p-4 text-sm text-body">
          <p class="font-bold text-ink">Prototype test account</p>
          <p>E-mail: <span class="font-medium text-ink">{{ site.testAccount.email }}</span><br>Password: <span class="font-medium text-ink">{{ site.testAccount.password }}</span></p>
          <button type="button" @click="fillTestAccount()" class="link self-start">Use test account</button>
        </div>
      </form>
    </section>

    {# New Customers #}
    <section class="flex flex-col gap-4 rounded bg-secondary-100 p-6 sm:p-10 md:gap-6" aria-labelledby="login-new" data-figma="14714:118263">
      <div class="flex max-w-[376px] flex-col gap-1">
        <h2 id="login-new" class="text-h4 font-medium tracking-title text-heading md:text-h3 md:tracking-normal">New Customers</h2>
        <p class="text-base text-body">Creating an account has many benefits.</p>
      </div>
      <ul class="flex flex-col gap-2 text-base text-ink">
        {% for b in ["Check out faster", "Store multiple shipping addresses", "View and track your orders"] %}
        <li class="flex items-center gap-3">{% icon "check", "h-6 w-6 text-accent" %}{{ b }}</li>
        {% endfor %}
      </ul>
      <a href="/customer/account/create/" class="btn-primary w-full">Create an Account</a>
    </section>
  </div>
</div>
