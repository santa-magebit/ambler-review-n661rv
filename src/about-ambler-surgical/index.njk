---
layout: layouts/base.njk
title: About Ambler Surgical
permalink: /about-ambler-surgical/
---
{# CMS - About Ambler Surgical (Figma 34974:1141); sticky sub-nav scrolled state 34971:56679.
   Phones: mobile 34974:121015 (section titles Medium 24/32 with -2% tracking, measured from the frame). #}
{% import "macros/ui.njk" as ui with context %}
{% import "content/macros.njk" as c with context %}
{% set a = contentPages.about %}

{{ ui.breadcrumbs([{ label: "About Ambler Surgical" }]) }}

{# Hero: surgeon photo (mirrored in Figma) under a navy fade. From lg the photo is Figma's 1600px (83% of the 1920 frame,
   right-aligned) and grows with wider screens; its left edge fades out (mask, mirrored with the photo) so it blends
   into the navy with no line.
   Phones (mobile 34974:121015): the photo unmirrored and right-aligned (blurred theatre, no surgeon) under the phone
   hero fade, 40/32 padding, 12px gap, 16/24 intro. #}
{{ c.hero({
  title: "About Ambler Surgical", text: a.intro, figma: "34971:47249", image: "fb1d6319",
  fade: contentPages.gradients.aboutFade, gap: "gap-3",
  photo: "inset-0 h-full w-full object-cover object-right md:-scale-x-100 md:object-center lg:inset-auto lg:right-0 lg:top-[calc(50%+29px)] lg:h-auto lg:w-[max(1600px,83.333%)] lg:max-w-none lg:-translate-y-1/2 lg:[mask-image:linear-gradient(270deg,transparent,#000_10%)]"
}) }}

{# Sticky sub-navigation: anchor tabs (orange underline on the section in view) + links to other pages.
   Phones (mobile 34974:121015, scrolled 34971:56818): 57px bar, tabs 24px apart scrolling edge to edge. #}
<nav x-data="aboutSubnav" aria-label="On this page" class="sticky top-[var(--header-h,0px)] z-30 border-b border-outline bg-white" data-figma="34974:1154">
  <div class="container-page flex items-center justify-between gap-10">
    <ul x-ref="tabs" class="-mx-5 flex min-w-0 gap-6 overflow-x-auto px-5 [scrollbar-width:none] md:mx-0 md:gap-10 md:px-0 [&::-webkit-scrollbar]:hidden" data-figma="34974:1155">
      {% for s in a.sections %}
      <li class="shrink-0">
        <a href="#{{ s.id }}" data-section="{{ s.id }}" @click="go('{{ s.id }}')"
           :aria-current="active === '{{ s.id }}' ? 'location' : null"
           :class="active === '{{ s.id }}' ? '!border-accent' : 'hover:border-secondary-200'"
           class="block whitespace-nowrap border-b-[3px] border-transparent pb-[13px] pt-4 text-base font-medium text-primary-500 transition-colors md:pb-[19px] md:pt-[22px]">{{ s.label }}</a>
      </li>
      {% endfor %}
    </ul>
    <div class="hidden shrink-0 items-center gap-8 min-[1400px]:flex" data-figma="34974:1166">
      <span aria-hidden="true" class="h-6 w-px bg-outline"></span>
      <a href="#" data-proto class="flex items-center gap-2 text-base font-medium text-primary-500 hover:text-primary-700">Upcoming Meetings{% icon "arrow-narrow-right" %}</a>
      <a href="#" data-proto class="flex items-center gap-2 text-base font-medium text-primary-500 hover:text-primary-700">Ambler Alliance{% icon "arrow-narrow-right" %}</a>
      <a href="/search/" x-data="catalogSearch" @click.prevent="open()" class="flex items-center gap-2 text-base font-medium text-primary-500 hover:text-primary-700">Cross Reference{% icon "arrow-narrow-right" %}</a>
    </div>
  </div>
</nav>

{# Who We Are + recent additions. #}
<section id="about-us" class="scroll-mt-[57px] bg-white md:scroll-mt-[69px]" data-figma="34974:1171">
  <div class="container-page grid gap-4 py-10 md:gap-12 lg:grid-cols-[720fr_768fr]">
    <div class="flex min-w-0 flex-col gap-4 md:gap-6" data-figma="34974:1173">
      <h2 class="text-h3 font-medium tracking-title text-heading md:text-h2 md:font-bold md:tracking-normal">Who We Are</h2>
      <p class="text-base text-body md:text-lg">{{ a.whoWeAre }}</p>
    </div>
    <div class="flex min-w-0 flex-col gap-4 rounded bg-secondary-100 px-5 py-6 sm:p-8 md:gap-5" data-figma="34974:1176">
      <h3 class="text-lg font-medium text-primary-500 md:text-h4">Recent additions to our online catalog:</h3>
      <div class="grid gap-3 sm:grid-cols-2 sm:gap-8">
        {% for col in a.recentAdditions %}
        <ul class="flex flex-col gap-3 text-base text-ink md:text-lg">
          {% for item in col %}{% call c.bullet() %}{{ item }}{% endcall %}{% endfor %}
        </ul>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{# Why Us: nurse photo (mirrored in Figma) fading into navy behind the text column.
   Phones (mobile 34974:121015): the photo is a 240px strip above the navy text block (32/40 padding), Medium 24/32
   title, 16/24 text. #}
<section id="why-us" class="relative isolate scroll-mt-[57px] overflow-hidden bg-primary-500 md:scroll-mt-[69px]" data-figma="34974:1221">
  <img src="{{ '8c9b5f40' | img }}" alt="" loading="lazy" class="relative -z-10 block h-[240px] w-full -scale-x-100 object-cover md:absolute md:inset-y-0 md:left-0 md:h-full lg:w-[65.1%]">
  <div aria-hidden="true" class="absolute inset-0 -z-10 hidden lg:block" style="background-image: {{ contentPages.gradients.whyFade }}"></div>
  <div aria-hidden="true" class="absolute inset-0 -z-10 hidden bg-primary-500/85 md:block lg:hidden"></div>
  <div class="container-page flex pb-10 pt-8 md:py-10 lg:min-h-[732px] lg:items-center">
    <div class="flex max-w-[856px] flex-col gap-4 text-base text-white md:gap-7 md:text-lg lg:ml-auto" data-figma="34974:1224">
      <h2 class="text-h3 font-medium tracking-title text-white md:text-h2 md:font-bold md:tracking-normal">Why Us?<br><span class="text-accent">The Smarter Source for affordable specialty instruments.</span></h2>
      <div class="flex flex-col gap-6">
        <p><strong class="font-bold">{{ a.whyLead.title }}</strong> {{ a.whyLead.text }}</p>
        <ul class="flex flex-col gap-3" data-figma="34974:1228">
          {% for w in a.why %}
          {% call c.bullet() %}<strong class="font-bold">{{ w.title }}</strong> {{ w.text }}{% if w.link %} {% if w.link.proto %}<a href="#" data-proto class="link-inverse">{{ w.link.label }}</a>{% else %}<a href="{{ w.link.href }}" class="link-inverse">{{ w.link.label }}</a>{% endif %}{{ w.after }}{% endif %}{% endcall %}
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

{# Executive Board: headshot placeholders with initials, name, role, email and bio.
   Phones (mobile 34974:121015): a 96px photo beside name, role and email, the bio under them cut to five lines
   with "Read more" (opens the whole bio), people 16px apart. #}
<section id="executive-board" class="scroll-mt-[57px] bg-[#f5f7fa] md:scroll-mt-[69px]" data-figma="34974:1257">
  <div class="container-page flex flex-col gap-4 py-10 md:gap-6">
    <h2 class="text-h3 font-medium tracking-title text-heading md:text-h2 md:font-bold md:tracking-normal">Executive Board</h2>
    <div class="flex flex-col gap-4 md:gap-10" data-figma="34974:1259">
      {% for p in a.board %}
      {% if not loop.first %}<hr class="border-outline">{% endif %}
      <article x-data="{ more: false }" class="grid grid-cols-[96px_minmax(0,1fr)] items-center gap-4 md:flex md:flex-row md:gap-12" data-figma="{{ p.figma }}">
        <div class="flex aspect-square w-full max-w-[240px] shrink-0 items-center justify-center rounded border border-outline bg-secondary-100 md:max-w-[280px] xl:max-w-[360px]" role="img" aria-label="Photo of {{ p.name }} coming soon">
          <span aria-hidden="true" class="text-h2 font-bold text-primary-500/25 md:text-[64px] md:leading-none xl:text-[96px] xl:leading-[112px]">{{ p.initials }}</span>
        </div>
        <div class="contents md:flex md:min-w-0 md:max-w-[1000px] md:flex-col md:gap-4">
          <div class="flex flex-col gap-1">
            <h3 class="text-h4 font-medium text-accent md:text-h3">{{ p.name }}</h3>
            <p class="text-[18px] leading-[26px] text-primary-500 md:text-h4">{{ p.role }}</p>
            <a href="mailto:{{ p.email }}" class="link self-start break-all text-base">{{ p.email }}</a>
          </div>
          <p id="bio-{{ loop.index }}" class="col-span-2 line-clamp-5 text-base text-body md:line-clamp-none md:text-lg" :class="{ 'line-clamp-5': !more }">{{ p.bio }}</p>
          <button type="button" x-show="!more" @click="more = true" aria-controls="bio-{{ loop.index }}" class="col-span-2 flex items-center gap-2 justify-self-start text-lg font-medium text-primary-500 hover:text-primary-700 md:hidden">Read more{{ c.chevronDown() }}</button>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# Societies & Affiliations. #}
<section id="societies-affiliations" class="scroll-mt-[57px] bg-white md:scroll-mt-[69px]" data-figma="34974:1279">
  <div class="container-page flex flex-col gap-4 pb-5 pt-10 md:gap-6">
    <h2 class="text-h3 font-medium tracking-title text-heading md:text-h2 md:font-bold md:tracking-normal">Societies &amp; Affiliations</h2>
    <div class="grid gap-6 md:gap-12 lg:grid-cols-[720fr_768fr] lg:items-center">
      <p class="min-w-0 text-base text-body md:text-lg">{{ a.societiesText }}</p>
      <ul class="grid min-w-0 grid-cols-2 gap-3 sm:grid-cols-3 md:gap-5" data-figma="34974:1283">
        {% for s in a.societies %}
        <li class="flex h-[60px] items-center justify-center rounded border border-outline bg-white md:h-20 {{ 'p-4 md:p-6' if s.image else 'px-4 py-2 md:px-5 md:py-3' }}">
          {% if s.image %}
          <img src="{{ s.image }}" alt="{{ s.name }}" loading="lazy" class="h-7 w-full object-contain md:h-8">
          {% else %}
          <span class="text-center font-medium tracking-title text-black {{ s.size }}">{{ s.name }}</span>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

{# Customer Testimonials slider: cards run off the right edge; progress line + previous/next. #}
<section id="customer-testimonials" x-data="slider" class="flex scroll-mt-[57px] flex-col gap-4 bg-white pb-10 pt-5 md:scroll-mt-[69px] md:gap-8" aria-labelledby="testimonials-title" data-figma="34974:1292">
  <div class="container-page"><h2 id="testimonials-title" class="text-h3 font-medium tracking-title text-heading md:text-h2 md:font-bold md:tracking-normal">Customer Testimonials</h2></div>
  <ul x-ref="track" @scroll.passive="update()" class="flex snap-x snap-mandatory gap-3 overflow-x-auto px-5 [scroll-padding-inline:20px] [scrollbar-width:none] md:gap-6 md:px-[max(2rem,calc((100%-1536px)/2))] md:[scroll-padding-inline:max(2rem,calc((100%-1536px)/2))] [&::-webkit-scrollbar]:hidden" data-figma="34974:1295">
    {% for t in a.testimonials %}
    <li class="flex w-[310px] shrink-0 snap-start flex-col gap-4 rounded border border-card bg-secondary-100 px-5 py-6 md:w-[min(744px,85vw)] md:gap-6 md:p-8" data-figma="{{ t.figma }}">
      {{ c.quoteMark() }}
      <blockquote class="flex-1 text-base text-heading md:text-lg">{{ t.quote }}</blockquote>
      <hr class="border-outline">
      <p class="flex flex-col gap-0.5">
        <span class="text-lg font-bold text-primary-500">{{ t.name }}</span>
        <span class="text-base text-body">{{ t.place }}</span>
      </p>
    </li>
    {% endfor %}
  </ul>
  {# Phones swipe the cards; the frame draws no progress line or arrows. #}
  <div class="container-page hidden md:block">
    <div class="flex items-center gap-6" data-figma="34974:1323">
      <div class="relative h-0.5 flex-1 bg-grayscale-300" aria-hidden="true">
        <span class="absolute inset-y-0 w-[24.36%] bg-primary-500 transition-[left] duration-150" :style="`left: ${progress * 75.64}%`"></span>
      </div>
      <div class="flex gap-3">
        <button type="button" @click="step(-1)" :disabled="atStart" aria-label="Previous testimonial" class="flex h-[52px] w-[52px] items-center justify-center rounded border border-secondary-200 bg-white text-primary-500 hover:bg-secondary-100 disabled:text-secondary-300 disabled:hover:bg-white">{% icon "arrow-left" %}</button>
        <button type="button" @click="step(1)" :disabled="atEnd" aria-label="Next testimonial" class="flex h-[52px] w-[52px] items-center justify-center rounded border border-secondary-200 bg-white text-primary-500 hover:bg-secondary-100 disabled:text-secondary-300 disabled:hover:bg-white">{% icon "arrow-right" %}</button>
      </div>
    </div>
  </div>
</section>

{# More from Ambler: three navy cards, side by side from 1024px (narrower, their one-line buttons don't fit). #}
<section class="bg-secondary-100" aria-label="More from Ambler" data-figma="34974:1331">
  <ul class="container-page grid gap-4 py-10 md:gap-6 lg:grid-cols-3">
    {% for card in a.ctas %}
    <li class="flex min-w-0 flex-col items-start gap-4 rounded bg-primary-500 p-6 lg:min-h-[365px] lg:p-8" data-figma="{{ card.figma }}">
      {% if card.icon %}{% icon card.icon, "h-14 w-14 text-white" %}{% else %}<img src="{{ card.image }}" alt="" class="h-14 w-14 object-contain">{% endif %}
      <h2 class="text-h4 font-medium text-white md:text-h3">{{ card.title }}</h2>
      <p class="flex-1 text-base text-secondary-200">{{ card.text }}</p>
      {% if card.action == "search" %}
      {{ c.arrowButton(card.button, "/search/", 'x-data="catalogSearch" @click.prevent="open()"') }}
      {% else %}
      {{ c.arrowButton(card.button, "#", "data-proto") }}
      {% endif %}
    </li>
    {% endfor %}
  </ul>
</section>
