{#
  "Related Products" (34224:49612): five 288px styleguide product cards per view, a 2px
  progress bar and prev/next buttons (34826:20504). Expects `related` (products) in scope.
  Phones (34224:49918): 310px mobile cards 8px apart, scrolled sideways to the screen edge,
  no progress bar or buttons. State: Alpine.data("relatedCarousel").
#}
{% import "macros/ui.njk" as ui with context %}
<section x-data="relatedCarousel" aria-labelledby="related-title" class="pb-8 pt-7 md:py-10 lg:py-20" data-figma="34224:49612">
  <div class="container-page flex flex-col gap-4 md:gap-10">
    <h2 id="related-title" class="text-h3 font-medium text-heading md:text-h2 md:font-bold">Related Products</h2>
    <ul x-ref="track" data-figma="34224:49615"
        class="-mx-5 -mb-8 -mt-3 grid scroll-px-5 snap-x snap-mandatory auto-cols-[310px] grid-flow-col gap-2 overflow-x-auto px-5 pb-8 pt-3 [scrollbar-width:none] md:mx-0 md:scroll-px-0 md:gap-6 md:px-0 md:auto-cols-[calc((100%-48px)/3)] lg:auto-cols-[calc((100%-72px)/4)] xl:auto-cols-[calc((100%-96px)/5)] [&::-webkit-scrollbar]:hidden">
      {% for p in related %}
      <li class="min-w-0 snap-start">{{ ui.productCard(p, true) }}</li>
      {% endfor %}
    </ul>
    <div class="hidden items-center gap-6 md:flex" data-figma="34826:20504">
      <div class="relative h-0.5 flex-1 bg-grayscale-300" aria-hidden="true">
        <div class="absolute inset-y-0 left-0 w-1/4 bg-primary-500" :style="`width:${thumb}%;left:${offset}%`"></div>
      </div>
      <div class="flex gap-3">
        <button type="button" @click="step(-1)" :disabled="atStart" aria-label="Previous products" class="btn-secondary w-[52px] px-0">{% icon "arrow-left" %}</button>
        <button type="button" @click="step(1)" :disabled="atEnd" aria-label="Next products" class="btn-secondary w-[52px] px-0">{% icon "arrow-right" %}</button>
      </div>
    </div>
  </div>
</section>
