---
layout: account/layout.njk
title: Dashboard
permalink: /customer/account/
figma: "14714:137050"
---
{% import "account/macros.njk" as acc with context %}
{# Phones ("Mobile - Dashboard" 14714:138225): 32px between blocks, 16px under the headings, 12px between cards. #}
<div class="flex flex-col gap-8 md:gap-10" data-figma="14714:137072">
  {{ acc.pageTitle("Dashboard") }}

  {# Account Information #}
  <section class="flex flex-col gap-4 md:gap-6" data-figma="14714:137074">
    {{ acc.sectionTitle("Account Information") }}
    <div class="grid gap-3 md:gap-6 xl:grid-cols-2">
      {% call acc.infoCard("user", "Contact Information", "14714:137077") %}
      <div class="flex flex-col gap-2 text-base text-body md:gap-3">
        <p>{{ account.customer.name }}</p>
        <p class="break-words">{{ account.customer.email }}</p>
      </div>
      {# Phones: one row, Change Password takes the rest of the width (95 + 195). #}
      <div class="flex gap-3 md:flex-wrap">
        <a href="/customer/account/edit/" class="btn-secondary">Edit</a>
        <a href="/customer/account/edit/?changepass" class="btn-secondary min-w-0 flex-1 px-0 md:flex-initial md:px-8">Change Password</a>
      </div>
      {% endcall %}
    </div>
  </section>

  {# Address Book #}
  <section class="flex flex-col gap-4 md:gap-6" data-figma="14714:137097">
    {{ acc.sectionTitle("Address Book", "/customer/address/", "Manage Addresses") }}
    <div class="grid gap-3 md:gap-6 xl:grid-cols-2" data-figma="14714:137101">
      {% call acc.infoCard("report-money", "Default Billing Address", "14714:137102") %}
      {{ acc.addressLines(account.defaultAddress, "T: ") }}
      <a href="/customer/address/new/" class="btn-secondary w-full px-6 md:w-fit">Edit Address</a>
      {% endcall %}
      {% call acc.infoCard("truck", "Default Shipping Address", "14714:137109") %}
      {{ acc.addressLines(account.defaultAddress, "T: ") }}
      <a href="/customer/address/new/" class="btn-secondary w-full px-6 md:w-fit">Edit Address</a>
      {% endcall %}
    </div>
  </section>

  {# Recent Orders #}
  <section class="flex flex-col gap-4 md:gap-6" data-figma="14714:137116">
    {{ acc.sectionTitle("Recent Orders", "/sales/order/history/", "View All") }}
    {{ acc.ordersTable(account.orders, "14714:137120") }}
  </section>
</div>
