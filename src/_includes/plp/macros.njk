{#
  Shared pieces of the product listing pages (Figma page "PLP").
  Import with: {% import "plp/macros.njk" as plp_ui with context %}
  Data and copy: src/_data/plp.js (global `plp`). Behaviour: src/assets/js/plp.js.
#}
{% import "macros/ui.njk" as ui with context %}

{# Text with [label](/href) links (copy from plp.js). #}
{% macro rich(text, linkClass="link") %}{{ text | escape | replace(r/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="' + linkClass + '">$1</a>') | safe }}{% endmacro %}

{#
  Hero (PLP heroes, e.g. 34719:11294): 480px, photo + navy gradient, text column 593px.
  Phones (mobile PLP heroes, e.g. 34726:18657): content height, padding 40/32, title Medium 32/40, text 16/24.
  h: { eyebrow?, title, text?, image (hash8), flip?, placement? ("right": photo on the right half), wide? (navy reaches further) }
#}
{% macro hero(h, figma) %}
<section class="relative overflow-hidden bg-white" data-figma="{{ figma }}">
  {% if h.placement == "right" %}
  <img src="{{ h.image | img }}" alt="" class="absolute inset-y-0 right-0 h-full w-full object-cover object-right md:w-[58%]">
  {% else %}
  <img src="{{ h.image | img }}" alt="" class="absolute inset-0 h-full w-full object-cover {{ '-scale-x-100 object-[50%_88%]' if h.flip }}">
  {% endif %}
  <div class="absolute inset-0" style="background-image: {{ plp.gradients.heroWide if h.wide else plp.gradients.hero }}"></div>
  <div class="absolute inset-0 bg-primary-500/70 md:hidden"></div>
  <div class="container-page relative flex items-center pb-8 pt-10 md:min-h-[480px] md:py-12">
    <div class="flex max-w-[593px] flex-col {{ 'gap-3' if h.eyebrow else 'gap-5' }} md:gap-7">
      <div class="flex flex-col gap-3">
        {% if h.eyebrow %}<p class="text-base text-white md:text-lg md:font-medium">{{ h.eyebrow }}</p>{% endif %}
        <h1 class="self-start bg-bottom bg-no-repeat pb-2 text-h2 font-medium text-white md:pb-2.5 md:text-hero" style="background-image: {{ plp.gradients.titleLine }}; background-size: 100% 2px">{{ h.title }}</h1>
      </div>
      {% if h.text %}<p class="text-base text-white md:text-lg">{{ h.text }}</p>{% endif %}
    </div>
  </div>
</section>
{% endmacro %}

{# Section title row: h2 (Bold 40/48 or 32/40; phones Medium 28/36 or 24/32) with an optional control on the right (caller), below it on phones. #}
{% macro titleRow(title, size="lg") %}
<div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-4">
  <h2 class="font-medium text-heading md:font-bold {{ 'text-mobile-h1 md:text-h1' if size == 'lg' else 'text-h3 md:text-h2' }}">{{ title }}</h2>
  {% if caller %}{{ caller() }}{% endif %}
</div>
{% endmacro %}

{# Dropdown panel shared by Quick Select, Sort By and Show (Figma "Quick Select - opened" 34879:7082). #}
{% set panelClass = "absolute right-0 top-full z-30 mt-1 max-h-[480px] w-full min-w-[240px] overflow-y-auto rounded border border-outline bg-white py-2 shadow-[0_8px_24px_0_rgba(13,48,84,0.12)]" %}
{% set optionClass = "block w-full px-5 py-2.5 text-left text-base text-body hover:bg-secondary-100 hover:font-medium hover:text-[#0d3155] focus:bg-secondary-100 focus:outline-none" %}
{% set controlClass = "flex h-[52px] w-full items-center justify-between gap-3 rounded border bg-white px-5 text-left text-lg font-medium" %}
{# The same control on phones reads like a secondary button: label centred in navy ("quick-select" 34726:18657). Pair with mControlState. #}
{% set mControlClass = "flex h-[52px] w-full items-center justify-center gap-2 rounded border bg-white px-5 text-lg font-medium text-primary-500 md:justify-between md:gap-3 md:text-left" %}
{% set mControlState = "open ? 'border-primary-500 md:text-ink' : 'border-secondary-200 md:text-body hover:border-grayscale-400'" %}

{#
  Quick Select (34873:118749): label + 240px control that opens a list of links.
  items: [{ label, href, filter? }]; filter ("group:value") filters the page's listing instead of navigating.
  proto: the targets are not designed (adds data-proto).
#}
{% macro quickSelect(items, placeholder="All Categories", figma="34873:118749", proto=false) %}
<div class="flex w-full items-center gap-5 md:w-auto" data-figma="{{ figma }}" x-data="{ open: false }" @click.outside="open = false" @keydown.escape="open = false">
  <span class="sr-only shrink-0 text-base text-body md:not-sr-only" id="qs-{{ figma | slugify }}">Quick Select:</span>
  <div class="relative w-full md:w-[240px] md:max-w-full">
    <button type="button" @click="open = !open" :aria-expanded="open" aria-haspopup="true" aria-labelledby="qs-{{ figma | slugify }} qs-{{ figma | slugify }}-v"
            class="{{ mControlClass }}" :class="{{ mControlState }}">
      <span class="md:hidden" aria-hidden="true">Quick Select</span>
      <span id="qs-{{ figma | slugify }}-v" class="hidden truncate md:inline">{{ placeholder }}</span>
      <span x-show="!open">{% icon "dropdown" %}</span><span x-show="open" x-cloak>{% icon "dropdown-up" %}</span>
    </button>
    <ul x-show="open" x-cloak x-transition.opacity class="{{ panelClass }}">
      {% for i in items %}
      <li><a href="{{ i.href }}" {% if proto %}data-proto{% endif %} {% if i.filter %}@click.prevent="open = false; $dispatch('plp-filter', '{{ i.filter }}')"{% endif %} class="{{ optionClass }}">{{ i.label }}</a></li>
      {% endfor %}
    </ul>
  </div>
</div>
{% endmacro %}

{#
  Category card for a type / product line (styleguide "Category card" 14714:57254, 34719:11312):
  366x366, navy border, 56px strip (title 24/32 + "N products"), photo. Hover: navy strip,
  and the description replaces the photo when Figma draws one. Phones ("category-card" 34726:18657):
  350x200, 44px strip with title 20/28 and count 16/24.
  c: { name, href, count?, image, fit ("cover"|"contain"), hover?: [paragraphs] }
#}
{% macro categoryCard(c, figma="34719:11312") %}
<a href="{{ c.href }}" {% if c.proto %}data-proto{% endif %} class="card-hover group flex h-[200px] min-w-0 flex-col overflow-hidden rounded border border-primary-500 bg-white md:aspect-square md:h-auto" data-figma="{{ figma }}">
  <span class="flex h-11 shrink-0 items-center justify-between gap-2 border-b border-transparent bg-[#f5f8fa] px-3 group-hover:bg-primary-500 group-focus-visible:bg-primary-500 md:h-14 md:px-5">
    <span class="truncate text-h4 font-medium tracking-title text-primary-500 group-hover:text-white group-focus-visible:text-white md:text-h3">{{ c.name }}</span>
    {% if c.count %}<span class="shrink-0 text-base text-primary-500 group-hover:text-secondary-100 group-focus-visible:text-secondary-100 md:text-lg">{{ c.count }} product{{ "s" if c.count != 1 }}</span>{% endif %}
  </span>
  <span class="relative block min-h-0 flex-1 overflow-hidden">
    <img src="{{ c.image }}" alt="" loading="lazy" class="h-full w-full {{ 'object-contain' if c.fit == 'contain' else 'object-cover' }} {{ 'object-top' if c.position == 'top' }} {{ 'group-hover:opacity-0 group-focus-visible:opacity-0' if c.hover }} {{ 'mix-blend-multiply' if c.style }}" {% if c.style %}style="{{ c.style }}"{% endif %}>
    {% if c.hover %}
    <span class="absolute inset-0 flex flex-col gap-2 p-5 text-base text-primary-500 opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100">
      {% for t in c.hover %}<span>{{ t }}</span>{% endfor %}
    </span>
    {% endif %}
  </span>
</a>
{% endmacro %}

{# 4-up grid of category cards (34719:11310); one column, gap 8 on phones. #}
{% macro cardGrid(cards, figma="34719:11310") %}
<ul class="grid gap-2 sm:grid-cols-2 md:gap-6 lg:grid-cols-3 xl:grid-cols-4" data-figma="{{ figma }}">
  {% for c in cards %}<li class="min-w-0">{{ categoryCard(c) }}</li>{% endfor %}
</ul>
{% endmacro %}

{#
  "Shop By Categories" card on the specialty page (34777:59000): strip with title + arrow, photo,
  and a "Select a Category" menu at the bottom listing the category's instrument types.
  Phones (34777:58812): 350x200, 44px strip (title 20/28), 40px menu row (16/24).
  c: { title, href, image, fit, menu: [{ label, href }] }
#}
{% macro navCard(c) %}
<div class="card-hover group/card relative flex h-[200px] min-w-0 flex-col rounded border border-primary-500 bg-white md:aspect-square md:h-auto" data-figma="34777:59000" x-data="{ open: false }" @click.outside="open = false" @keydown.escape="open = false">
  <a href="{{ c.href }}" class="group flex h-11 shrink-0 items-center gap-3 rounded-t bg-[#f5f8fa] px-3 hover:bg-primary-500 md:h-14 md:px-5">
    <span class="truncate text-h4 font-medium tracking-title text-primary-500 group-hover:text-white md:text-h3">{{ c.title }}</span>
    {% icon "arrow-narrow-right", "h-6 w-6 text-primary-500 group-hover:text-white" %}
  </a>
  <a href="{{ c.href }}" tabindex="-1" aria-hidden="true" class="block min-h-0 flex-1 overflow-hidden">
    <img src="{{ c.image }}" alt="" loading="lazy" class="h-full w-full {{ 'object-contain' if c.fit == 'contain' else 'object-cover' }} {{ 'object-top' if c.position == 'top' }} {{ 'mix-blend-multiply' if c.style }}" {% if c.style %}style="{{ c.style }}"{% endif %}>
  </a>
  {% if c.menu.length %}
  <button type="button" @click="open = !open" :aria-expanded="open" class="flex h-10 shrink-0 items-center justify-between rounded-b bg-white px-3 text-base text-primary-500 hover:bg-secondary-100 md:h-[52px] md:px-5 md:text-lg">
    Select a Category
    <span x-show="!open">{% icon "dropdown", "h-6 w-6" %}</span><span x-show="open" x-cloak>{% icon "dropdown-up", "h-6 w-6" %}</span>
  </button>
  <ul x-show="open" x-cloak x-transition.opacity class="absolute inset-x-0 top-full z-30 mt-1 max-h-[320px] overflow-y-auto rounded border border-outline bg-white py-2 shadow-[0_8px_24px_0_rgba(13,48,84,0.12)]">
    {% for i in c.menu %}<li><a href="{{ i.href }}" class="{{ optionClass }}">{{ i.label }}</a></li>{% endfor %}
  </ul>
  {% else %}
  <a href="{{ c.href }}" class="flex h-10 shrink-0 items-center justify-between rounded-b bg-white px-3 text-base text-primary-500 hover:bg-secondary-100 md:h-[52px] md:px-5 md:text-lg">Select a Category{% icon "dropdown", "h-6 w-6" %}</a>
  {% endif %}
</div>
{% endmacro %}

{#
  "Popular Products" (34777:59002): title + "Show all Products", a grid of `count` product cards.
  "Show all Products" reveals the rest of the page's products in place. Phones (34777:58812): one column,
  gap 8, the button full width under the list and no bottom padding (the next section has 32px on top).
#}
{% macro popularProducts(products, count, figma, top=false) %}
<section class="bg-white" data-figma="{{ figma }}" x-data="{ all: false }">
  <div class="container-page md:pb-10 {{ 'pt-8 md:pt-10' if top }}">
    {% call titleRow("Popular Products", "md") %}
      {% if products.length > count %}<button type="button" x-show="!all" @click="all = true" class="btn-secondary hidden md:inline-flex">Show all Products</button>{% endif %}
    {% endcall %}
    <ul class="mt-4 grid gap-2 sm:grid-cols-2 md:mt-8 md:gap-6 lg:grid-cols-3 xl:grid-cols-4">
      {% for p in products %}
      <li class="min-w-0" {% if loop.index > count %}x-show="all" x-cloak{% endif %}>{{ ui.productCard(p) }}</li>
      {% endfor %}
    </ul>
    {% if products.length > count %}<button type="button" x-show="!all" @click="all = true" class="btn-secondary mt-4 w-full md:hidden">Show all Products</button>{% endif %}
  </div>
</section>
{% endmacro %}

{#
  Product listing (Product Type Page 34723:17020): filter panel ("filters - opened" 34793:65750),
  "Products N results" toolbar with search within + sort, the product grid and pagination with "Show".
  All product cards are rendered here; Alpine.data("plpListing") shows the current page's cards
  (x-show) in the sorted order (CSS order). l: plp.js listing().
  Phones (Product Type Page 34730:7891): no filter panel; under the title a full-width search and
  "Filters" + "Sort By" buttons, one column of cards (gap 8) and a centred 3-page pager.
  "Filters" opens the filter screen (mobile-filters 34731:36331). pad: phone padding of the products section.
#}
{% macro listing(l, figma="34723:17181", cloak=false, pad="py-8") %}
<div x-data="plpListing({{ l.cfg | json }})" {% if cloak %}x-cloak{% endif %} @plp-filter.window="only($event.detail)" id="{{ l.id }}" class="scroll-mt-4">
  {% if l.filters.length %}
  {# Filter panel (768px and up) #}
  <section class="hidden bg-white py-10 md:block" data-figma="34793:65750" aria-label="Filters" x-show="found.length">
    <div class="container-page">
      <div class="rounded border border-card bg-white" data-figma="34793:65752">
        <div class="flex flex-wrap items-start gap-x-4 gap-y-2 border-b border-card px-4 py-3 md:px-6" data-figma="34793:65753">
          <p class="flex h-9 items-center gap-2 text-lg font-bold text-heading">
            Filters
            <span x-show="applied.length" x-cloak x-text="applied.length" class="rounded border border-secondary-200 bg-white px-1 py-0.5 text-sm font-bold text-ink"></span>
          </p>
          <p x-show="!applied.length" class="flex h-9 items-center text-base text-body">No filters applied yet</p>
          {# One row of chips: the ones that don't fit (measured, see fitChips) wait behind "+x more", which shows them all. #}
          <ul x-show="applied.length" x-cloak x-ref="chips" class="flex min-w-0 flex-1 items-center gap-2" :class="allChips ? 'flex-wrap' : 'flex-nowrap'" aria-label="Active filters">
            <template x-for="(key, i) in applied" :key="key">
              <li x-show="chipShown(i)" data-chip class="flex h-9 shrink-0 items-center gap-2 whitespace-nowrap rounded bg-[#eff7fd] py-1.5 pl-4 pr-3 text-base text-heading">
                <span><span class="font-medium" x-text="groupLabel(key) + ':'"></span> <span x-text="valueLabel(key)"></span></span>
                <button type="button" @click="remove(key)" :aria-label="'Remove filter ' + groupLabel(key) + ' ' + valueLabel(key)" class="flex h-6 w-6 items-center justify-center text-heading hover:text-accent">{% icon "close-x", "h-4 w-4" %}</button>
              </li>
            </template>
            <li x-show="measuring || hiddenChips > 0" class="shrink-0">
              <button type="button" x-ref="more" @click="allChips = true" class="link h-9 whitespace-nowrap px-2 text-base" x-text="'+' + (measuring ? applied.length : hiddenChips) + ' more'"></button>
            </li>
          </ul>
          <button type="button" x-show="applied.length" x-cloak @click="clearAll()" class="link ml-auto h-9 text-base">Clear all</button>
        </div>
        <div class="flex flex-col bg-secondary-100 md:flex-row" data-figma="34793:65769">
          <ul class="flex shrink-0 flex-row overflow-x-auto bg-white py-2 shadow-[2px_0_10px_0_rgba(31,41,55,0.1)] md:w-[288px] md:flex-col" aria-label="Filter by">
            {% for a in l.filters %}
            <li class="shrink-0">
              <button type="button" @click="active = '{{ a.key }}'" :aria-pressed="active === '{{ a.key }}'" aria-controls="{{ l.id }}-{{ a.key }}"
                      class="flex h-8 w-full items-center justify-between gap-2 whitespace-nowrap border-l-[3px] pl-6 pr-5 text-lg font-medium"
                      :class="active === '{{ a.key }}' ? 'border-accent bg-[#f5f7fa] text-accent' : 'border-transparent text-primary-500 hover:text-accent'">
                <span class="flex items-center gap-2">{{ a.label }}<span x-show="attrCount('{{ a.key }}')" x-cloak x-text="attrCount('{{ a.key }}')" class="rounded border border-secondary-200 bg-white px-1 py-0.5 text-sm font-bold leading-5 text-ink"></span></span>
                <span x-show="active === '{{ a.key }}'" class="hidden md:block">{% icon "chevron-right", "h-7 w-7" %}</span>
              </button>
            </li>
            {% endfor %}
          </ul>
          <div class="flex min-w-0 flex-1 flex-col gap-6 px-4 py-4 md:pl-10 md:pr-8">
            {% for a in l.filters %}
            <div id="{{ l.id }}-{{ a.key }}" x-show="active === '{{ a.key }}'" {% if a.key != l.cfg.active %}x-cloak{% endif %} class="flex flex-wrap gap-x-10 gap-y-6">
              {% for g in a.groups %}
              <fieldset class="min-w-0">
                <legend class="mb-1 text-lg font-bold text-primary-500">{{ g.label }}</legend>
                <div class="flex flex-col {{ 'sm:grid sm:auto-cols-max sm:grid-flow-col sm:grid-rows-[repeat(6,auto)] sm:gap-x-10' if g.options.length > 6 }}">
                {% for o in g.options %}
                <label class="flex cursor-pointer items-center gap-2 py-1" x-show="countOf('{{ o.key }}') > 0 || applied.includes('{{ o.key }}')">
                  <input type="checkbox" value="{{ o.key }}" x-model="applied" class="peer sr-only">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded border border-secondary-200 bg-white text-white peer-checked:border-primary-500 peer-checked:bg-primary-500 peer-focus-visible:ring-2 peer-focus-visible:ring-primary-200">{% icon "check-small", "h-5 w-5" %}</span>
                  <span class="ml-1 text-base text-body peer-checked:text-ink">{{ o.value }}</span>
                  <span class="rounded border border-secondary-200 bg-white px-1 py-0.5 text-sm font-bold text-ink" x-text="countOf('{{ o.key }}')">{{ o.count }}</span>
                </label>
                {% endfor %}
                </div>
              </fieldset>
              {% endfor %}
            </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </section>

  {#
    Filter screen on phones (mobile-filters 34731:36331): "Now Shopping by" with the applied filters,
    then one row per attribute that opens its groups of checkboxes. Ticking a box filters straight away,
    like the panel; Apply Filters closes the screen, Cancel puts back the filters it opened with.
  #}
  <div x-show="sheet" x-cloak x-trap="sheet" x-effect="lockScroll('mobile-filters', sheet)" @keydown.escape="sheet = false"
       class="fixed inset-0 z-50 flex flex-col bg-white md:hidden" role="dialog" aria-modal="true" aria-labelledby="{{ l.id }}-sheet-title" data-figma="34731:36331">
    <div class="flex h-14 shrink-0 items-center justify-between border-b border-outline pl-5">
      <h2 id="{{ l.id }}-sheet-title" class="text-h3 font-medium text-heading">Filters</h2>
      <button type="button" @click="sheet = false" aria-label="Close filters" class="flex h-14 w-14 items-center justify-center border-l border-outline text-primary-500 hover:text-accent">{% icon "close-x", "h-6 w-6" %}</button>
    </div>
    <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain">
      <div x-show="applied.length" class="flex flex-col gap-3 border-b border-secondary-200 bg-secondary-100 p-5">
        <p class="text-lg font-medium text-heading">Now Shopping by</p>
        <ul class="flex flex-col gap-1" aria-label="Active filters">
          <template x-for="key in applied" :key="key">
            <li class="flex items-center gap-1 text-base text-body">
              <span><span class="font-medium text-heading" x-text="groupLabel(key) + ':'"></span> <span x-text="valueLabel(key)"></span></span>
              <button type="button" @click="remove(key)" :aria-label="'Remove filter ' + groupLabel(key) + ' ' + valueLabel(key)" class="flex h-6 w-6 items-center justify-center text-heading hover:text-accent">{% icon "close-x", "h-4 w-4" %}</button>
            </li>
          </template>
        </ul>
        <button type="button" @click="clearAll()" class="btn-secondary w-full">Clear All Filters</button>
      </div>
      {% for a in l.filters %}
      <div class="border-b border-secondary-200 last:border-b-0">
        <button type="button" @click="sheetAttr = sheetAttr === '{{ a.key }}' ? null : '{{ a.key }}'" :aria-expanded="sheetAttr === '{{ a.key }}'" aria-controls="{{ l.id }}-m-{{ a.key }}"
                class="flex w-full items-center gap-2 border-l-[3px] py-5 pl-[17px] pr-5 text-left text-lg font-medium"
                :class="sheetAttr === '{{ a.key }}' ? 'border-accent bg-[#f5f7fa] text-accent' : 'border-transparent text-heading'">
          {{ a.label }}
          <span x-show="attrCount('{{ a.key }}')" x-cloak x-text="attrCount('{{ a.key }}')" class="rounded border border-secondary-200 bg-white px-1 py-0.5 text-sm font-bold leading-5 text-ink"></span>
          <span class="ml-auto text-ink" x-show="sheetAttr !== '{{ a.key }}'">{% icon "plus-xs" %}</span>
          <span class="ml-auto" x-show="sheetAttr === '{{ a.key }}'" x-cloak>{% icon "minus-xs" %}</span>
        </button>
        <div id="{{ l.id }}-m-{{ a.key }}" x-show="sheetAttr === '{{ a.key }}'" x-collapse x-cloak>
          {% for g in a.groups %}
          <div role="group" aria-labelledby="{{ l.id }}-m-{{ g.key }}" class="border-t border-secondary-200">
            <p id="{{ l.id }}-m-{{ g.key }}" class="px-5 pb-1 pt-5 text-lg font-bold text-primary-500">{{ g.label }}</p>
            {% for o in g.options %}
            <label class="flex cursor-pointer items-center gap-2 p-5" x-show="countOf('{{ o.key }}') > 0 || applied.includes('{{ o.key }}')">
              <input type="checkbox" value="{{ o.key }}" x-model="applied" class="peer sr-only">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded border border-secondary-200 bg-white text-white peer-checked:border-primary-500 peer-checked:bg-primary-500 peer-focus-visible:ring-2 peer-focus-visible:ring-primary-200">{% icon "check-small", "h-5 w-5" %}</span>
              <span class="ml-1 text-base text-body peer-checked:text-ink">{{ o.value }}</span>
              <span class="rounded border border-secondary-200 bg-white px-1 py-0.5 text-sm font-bold text-ink" x-text="countOf('{{ o.key }}')">{{ o.count }}</span>
            </label>
            {% endfor %}
          </div>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
    <div class="flex shrink-0 gap-3 border-t border-secondary-200 bg-white p-5">
      <button type="button" @click="cancelSheet()" class="btn-secondary flex-1 px-4">Cancel</button>
      <button type="button" @click="sheet = false" class="btn-primary flex-1 px-4">Apply Filters</button>
    </div>
  </div>
  {% endif %}

  {# Products #}
  <section class="bg-white {{ pad }} md:py-10" data-figma="{{ figma }}" x-ref="top" aria-label="Products">
    <div class="container-page">
      <div class="flex flex-wrap items-center justify-between gap-x-10 gap-y-4" data-figma="34723:17182" x-show="found.length">
        <h2 class="flex items-baseline gap-2 text-mobile-h1 font-medium text-heading md:text-h1 md:font-bold">Products <span class="text-base font-normal text-body md:text-lg" x-text="resultsLabel">{{ l.products.length }} result{{ "s" if l.products.length != 1 }}</span></h2>
        <div class="flex w-full flex-wrap items-center gap-x-3 gap-y-4 md:w-auto md:gap-x-10">
          <label class="relative block w-full md:w-[320px]">
            <span class="sr-only">Search within {{ l.cfg.title }}</span>
            <span class="pointer-events-none absolute left-5 top-1/2 -translate-y-1/2 text-primary-500">{% icon "search" %}</span>
            <input type="search" x-model.debounce.150ms="within" @input="page = 1" placeholder="Search within {{ l.cfg.title }}" class="input pl-[60px] font-medium placeholder:font-medium">
          </label>
          {% if l.filters.length %}
          <button type="button" @click="openSheet()" aria-haspopup="dialog" class="btn-secondary flex-1 px-4 md:hidden">
            Filters<span x-show="applied.length" x-cloak x-text="applied.length" class="rounded border border-secondary-200 bg-white px-1 py-0.5 text-sm font-bold leading-5 text-ink"></span>
          </button>
          {% endif %}
          <div class="flex flex-1 items-center gap-5 md:flex-initial" x-data="{ open: false }" @click.outside="open = false" @keydown.escape="open = false">
            <span class="sr-only shrink-0 text-base text-body md:not-sr-only" id="{{ l.id }}-sort">Sort By:</span>
            <div class="relative w-full md:w-auto md:min-w-[227px]">
              <button type="button" @click="open = !open" :aria-expanded="open" aria-haspopup="true" aria-labelledby="{{ l.id }}-sort {{ l.id }}-sort-v" class="{{ mControlClass }}" :class="{{ mControlState }}">
                <span class="md:hidden" aria-hidden="true">Sort By</span>
                <span id="{{ l.id }}-sort-v" class="hidden whitespace-nowrap md:inline" x-text="sortLabel">Product name A-Z</span>
                <span x-show="!open">{% icon "dropdown" %}</span><span x-show="open" x-cloak>{% icon "dropdown-up" %}</span>
              </button>
              <ul x-show="open" x-cloak x-transition.opacity class="{{ panelClass }}">
                <template x-for="o in sorts" :key="o.value">
                  <li><button type="button" @click="setSort(o.value); open = false" class="{{ optionClass }}" :class="sort === o.value && 'font-medium text-[#0d3155]'" x-text="o.label"></button></li>
                </template>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <ul class="mt-4 grid gap-2 sm:grid-cols-2 md:mt-8 md:gap-6 lg:grid-cols-3 xl:grid-cols-4" data-figma="34723:17196">
        {% for p in l.products %}
        <li class="min-w-0" x-show="isShown('{{ p.slug }}')" :style="{ order: rank('{{ p.slug }}') }" {% if loop.index > l.perPage %}style="display: none"{% endif %}>{{ ui.productCard(p) }}</li>
        {% endfor %}
      </ul>
      <div x-show="!total" x-cloak class="mt-4 flex flex-col items-center gap-5 rounded border border-secondary-200 px-6 py-12 text-center md:mt-8">
        <p class="text-lg text-heading">We couldn&rsquo;t find anything for your search</p>
        <div x-show="found.length"><button type="button" @click="clearAll(); within = ''" class="btn-secondary">Clear all</button></div>
        <div x-show="!found.length" class="flex flex-wrap justify-center gap-4">
          <a href="/browse-by-specialty/" class="btn-primary">Browse by Specialty</a>
          <a href="/browse-by-type/" class="btn-secondary">Browse by Type</a>
        </div>
      </div>

      {# Pagination (34723:17222) #}
      {# One line whenever it fits; from lg the pager sits centred between the two. Phones show only the pager, centred, with 3 pages (34730:7891). #}
      <div x-show="total" class="mt-4 flex flex-wrap items-center justify-center gap-x-6 gap-y-4 md:mt-8 md:justify-between lg:grid lg:grid-cols-[1fr_auto_1fr] lg:gap-4" data-figma="34723:17222">
        <p class="hidden text-base text-body md:block" x-text="itemsLabel">Items 1-{{ l.perPage if l.products.length > l.perPage else l.products.length }} of {{ l.products.length }}</p>
        <nav aria-label="Pagination" class="flex flex-wrap items-center gap-3">
          <button type="button" @click="go(current - 1)" :disabled="current <= 1" aria-label="Previous page" class="flex h-[52px] w-[52px] items-center justify-center rounded border border-secondary-200 bg-white text-primary-500 hover:bg-[#f5f5f5] disabled:cursor-default disabled:opacity-40">{% icon "arrow-left" %}</button>
          <template x-for="n in pageList" :key="n">
            <button type="button" @click="go(n)" :aria-current="n === current ? 'page' : null" x-text="n"
                    class="flex h-[52px] min-w-[52px] items-center justify-center rounded border px-3 text-lg font-medium"
                    :class="[n === current ? 'border-secondary-200 bg-secondary-200 text-secondary-300' : 'border-secondary-200 bg-white text-primary-500 hover:bg-[#f5f5f5]', nearPage(n) ? '' : 'hidden md:flex']"></button>
          </template>
          <button type="button" @click="go(current + 1)" :disabled="current >= pages" aria-label="Next page" class="flex h-[52px] w-[52px] items-center justify-center rounded border border-secondary-200 bg-white text-primary-500 hover:bg-[#f5f5f5] disabled:cursor-default disabled:opacity-40">{% icon "arrow-right" %}</button>
        </nav>
        <div class="hidden items-center gap-5 md:flex lg:justify-self-end" x-data="{ open: false }" @click.outside="open = false" @keydown.escape="open = false">
          <span class="text-base text-body" id="{{ l.id }}-show">Show:</span>
          <div class="relative w-[104px]">
            <button type="button" @click="open = !open" :aria-expanded="open" aria-haspopup="true" aria-labelledby="{{ l.id }}-show {{ l.id }}-show-v" class="{{ controlClass }}" :class="open ? 'border-primary-500 text-ink' : 'border-secondary-200 text-body hover:border-grayscale-400'">
              <span id="{{ l.id }}-show-v" x-text="perPage">{{ l.perPage }}</span>
              <span x-show="!open">{% icon "dropdown" %}</span><span x-show="open" x-cloak>{% icon "dropdown-up" %}</span>
            </button>
            <ul x-show="open" x-cloak x-transition.opacity class="absolute bottom-full right-0 z-30 mb-1 w-full rounded border border-outline bg-white py-2 shadow-[0_8px_24px_0_rgba(13,48,84,0.12)]">
              <template x-for="n in perPageOptions" :key="n">
                <li><button type="button" @click="setPerPage(n); open = false" class="{{ optionClass }}" :class="perPage === n && 'font-medium text-[#0d3155]'" x-text="n"></button></li>
              </template>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
{% endmacro %}

{#
  "Free Lifetime Repair" banner (34777:59015). Phones (34777:58812): title and the seal (130x126,
  rising 26px above the navy) side by side, text and a full-width button below.
#}
{% macro repairBanner() %}
<section class="bg-white pt-8 md:py-10" data-figma="34777:59015">
